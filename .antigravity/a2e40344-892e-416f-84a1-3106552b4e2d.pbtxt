    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useEffect, useState } from \'react\';\nimport { useAuth } from \'../components/AuthContext.tsx\';\nimport { useNavigate } from \'react-router\';\nimport { BookOpen } from \'lucide-react\';\nimport { motion } from \'motion/react\';\nimport { api } from \'../lib/api.ts\';\n\nexport default function Login() {\n  const { dbUser, signIn, loading } = useAuth();\n  const navigate = useNavigate();\n  const [isRegistering, setIsRegistering] = useState(false);\n  const [error, setError] = useState(\'\');\n  const [formData, setFormData] = useState({\n    name: \'\',\n    username: \'\',\n    password: \'\',\n    role: \'student\'\n  });\n\n  useEffect(() => {\n    if (dbUser && !loading) {\n      navigate(\'/\');\n    }\n  }, [dbUser, loading, navigate]);\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setError(\'\');\n    try {\n      if (isRegistering) {\n        const data = await api.post(\'/api/auth/register\', formData);\n        signIn(data.token, data.user);\n      } else {\n        const data = await api.post(\'/api/auth/login\', { username: formData.username, password: formData.password });\n        signIn(data.token, data.user);\n      }\n    } catch (err: any) {\n      setError(err.message || \'Authentication failed\');\n    }\n  };\n\n  return (\n    <div className=\"flex-1 flex items-center justify-center p-4\">\n      <motion.div \n        initial={{ opacity: 0, y: 20 }}\n        animate={{ opacity: 1, y: 0 }}\n        className=\"glass-card p-10 rounded-3xl w-full max-w-md\"\n      >\n        <div className=\"mx-auto w-16 h-16 bg-indigo-500/20 rounded-2xl flex items-center justify-center mb-6\">\n          <BookOpen className=\"w-8 h-8 text-indigo-400\" />\n        </div>\n        <h1 className=\"text-3xl font-bold mb-2 tracking-tight text-center\">IELTS Workspace</h1>\n        <p className=\"text-slate-400 mb-8 text-center\">{isRegistering ? \'Create your account\' : \'Sign in to access your assignments.\'}</p>\n        \n        {error && (\n          <div className=\"mb-4 p-3 bg-red-500/10 border border-red-500/30 rounded-lg text-red-400 text-sm\">\n            {error}\n          </div>\n        )}\n\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          {isRegistering && (\n            <div>\n              <label className=\"block text-sm font-medium text-slate-300 mb-1\">Full Name</label>\n              <input \n                type=\"text\" \n                required \n                className=\"w-full glass-input px-4 py-3 rounded-xl text-sm\" \n                placeholder=\"John Doe\"\n                value={formData.name}\n                onChange={e => setFormData({ ...formData, name: e.target.value })}\n              />\n            </div>\n          )}\n          \n          <div>\n            <label className=\"block text-sm font-medium text-slate-300 mb-1\">Username</label>\n            <input \n              type=\"text\" \n              required \n              className=\"w-full glass-input px-4 py-3 rounded-xl text-sm\" \n              placeholder=\"student123\"\n              value={formData.username}\n              onChange={e => setFormData({ ...formData, username: e.target.value })}\n            />\n          </div>\n          \n          <div>\n            <label className=\"block text-sm font-medium text-slate-300 mb-1\">Password</label>\n            <input \n              type=\"password\" \n              required \n              className=\"w-full glass-input px-4 py-3 rounded-xl text-sm\" \n              placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n              value={formData.password}\n              onChange={e => setFormData({ ...formData, password: e.target.value })}\n            />\n          </div>\n\n          {isRegistering && (\n            <div>\n              <label className=\"block text-sm font-medium text-slate-300 mb-1\">Role</label>\n              <select \n                className=\"w-full glass-input px-4 py-3 rounded-xl text-sm appearance-none\"\n                value={formData.role}\n                onChange={e => setFormData({ ...formData, role: e.target.value })}\n              >\n                <option value=\"student\">Student</option>\n                <option value=\"teacher\">Teacher</option>\n              </select>\n            </div>\n          )}\n          \n          <button\n            type=\"submit\"\n            className=\"w-full gradient-btn py-3 px-4 rounded-xl font-medium flex items-center justify-center space-x-2 mt-2\"\n          >\n            <span>{isRegistering ? \'Create Account\' : \'Sign In\'}</span>\n          </button>\n        </form>\n        \n        <div className=\"mt-6 text-center text-sm text-slate-400\">\n          {isRegistering ? \'Already have an account?\' : \"Don\'t have an account?\"}\n          <button \n            type=\"button\" \n            className=\"ml-2 text-indigo-400 hover:text-indigo-300 font-medium transition-colors\"\n            onClick={() => { setIsRegistering(!isRegistering); setError(\'\'); }}\n          >\n            {isRegistering ? \'Sign in here\' : \'Register here\'}\n          </button>\n        </div>\n      </motion.div>\n    </div>\n  );\n}"
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { useAuth } from \'../components/AuthContext.tsx\';\nimport { useNavigate } from \'react-router\';\nimport { BookOpen } from \'lucide-react\';\nimport { motion } from \'motion/react\';\nimport { api } from \'../lib/api.ts\';\n\nexport default function Login() {\n  const { dbUser, signIn, loading } = useAuth();\n  const navigate = useNavigate();\n  const [error, setError] = useState(\'\');\n  const [formData, setFormData] = useState({\n    username: \'\',\n    password: \'\',\n  });\n\n  useEffect(() => {\n    if (dbUser && !loading) {\n      navigate(\'/\');\n    }\n  }, [dbUser, loading, navigate]);\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setError(\'\');\n    try {\n      const data = await api.post(\'/api/auth/login\', { username: formData.username, password: formData.password });\n      signIn(data.token, data.user);\n    } catch (err: any) {\n      setError(err.message || \'Authentication failed\');\n    }\n  };\n\n  return (\n    <div className=\"flex-1 flex items-center justify-center p-4\">\n      <motion.div \n        initial={{ opacity: 0, y: 20 }}\n        animate={{ opacity: 1, y: 0 }}\n        className=\"glass-card p-10 rounded-3xl w-full max-w-md\"\n      >\n        <div className=\"mx-auto w-16 h-16 bg-indigo-500/20 rounded-2xl flex items-center justify-center mb-6\">\n          <BookOpen className=\"w-8 h-8 text-indigo-400\" />\n        </div>\n        <h1 className=\"text-3xl font-bold mb-2 tracking-tight text-center\">IELTS Workspace</h1>\n        <p className=\"text-slate-400 mb-8 text-center\">Sign in to access your assignments.</p>\n        \n        {error && (\n          <div className=\"mb-4 p-3 bg-red-500/10 border border-red-500/30 rounded-lg text-red-400 text-sm\">\n            {error}\n          </div>\n        )}\n\n        <form onSubmit={handleSubmit} className=\"space-y-4\">\n          \n          <div>\n            <label className=\"block text-sm font-medium text-slate-300 mb-1\">Username</label>\n            <input \n              type=\"text\" \n              required \n              className=\"w-full glass-input px-4 py-3 rounded-xl text-sm\" \n              placeholder=\"student123\"\n              value={formData.username}\n              onChange={e => setFormData({ ...formData, username: e.target.value })}\n            />\n          </div>\n          \n          <div>\n            <label className=\"block text-sm font-medium text-slate-300 mb-1\">Password</label>\n            <input \n              type=\"password\" \n              required \n              className=\"w-full glass-input px-4 py-3 rounded-xl text-sm\" \n              placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n              value={formData.password}\n              onChange={e => setFormData({ ...formData, password: e.target.value })}\n            />\n          </div>\n\n          <button\n            type=\"submit\"\n            className=\"w-full gradient-btn py-3 px-4 rounded-xl font-medium flex items-center justify-center space-x-2 mt-2\"\n          >\n            <span>Sign In</span>\n          </button>\n        </form>\n      </motion.div>\n    </div>\n  );\n}"
    }
