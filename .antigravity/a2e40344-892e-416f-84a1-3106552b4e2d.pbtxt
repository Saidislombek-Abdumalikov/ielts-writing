    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { createContext, useContext, useEffect, useState } from \'react\';\nimport { onAuthStateChanged, User, signInWithPopup } from \'firebase/auth\';\nimport { auth, googleAuthProvider } from \'../lib/firebase.ts\';\nimport { api } from \'../lib/api.ts\';\n\ninterface DbUser {\n  id: number;\n  uid: string;\n  name: string;\n  email: string;\n  role: \'teacher\' | \'student\';\n}\n\ninterface AuthContextType {\n  user: User | null;\n  dbUser: DbUser | null;\n  loading: boolean;\n  signIn: () => Promise<void>;\n  signOut: () => Promise<void>;\n}\n\nconst AuthContext = createContext<AuthContextType>({\n  user: null,\n  dbUser: null,\n  loading: true,\n  signIn: async () => {},\n  signOut: async () => {},\n});\n\nexport const AuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  const [user, setUser] = useState<User | null>(null);\n  const [dbUser, setDbUser] = useState<DbUser | null>(null);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    const unsubscribe = onAuthStateChanged(auth, async (firebaseUser) => {\n      setUser(firebaseUser);\n      if (firebaseUser) {\n        try {\n          const fetchedDbUser = await api.post(\'/api/auth/register\', {});\n          setDbUser(fetchedDbUser);\n        } catch (error) {\n          console.error(\"Failed to sync user\", error);\n        }\n      } else {\n        setDbUser(null);\n      }\n      setLoading(false);\n    });\n\n    return () => unsubscribe();\n  }, []);\n\n  const signIn = async () => {\n    try {\n      await signInWithPopup(auth, googleAuthProvider);\n    } catch (error) {\n      console.error(\"Login failed\", error);\n    }\n  };\n\n  const signOut = async () => {\n    await auth.signOut();\n  };\n\n  return (\n    <AuthContext.Provider value={{ user, dbUser, loading, signIn, signOut }}>\n      {children}\n    </AuthContext.Provider>\n  );\n};\n\nexport const useAuth = () => useContext(AuthContext);"
      replacement_content: "import React, { createContext, useContext, useEffect, useState } from \'react\';\nimport { api } from \'../lib/api.ts\';\n\ninterface User {\n  id: number;\n  username: string;\n  name: string;\n  email: string | null;\n  role: \'teacher\' | \'student\';\n}\n\ninterface AuthContextType {\n  dbUser: User | null;\n  loading: boolean;\n  signIn: (token: string, user: User) => void;\n  signOut: () => void;\n}\n\nconst AuthContext = createContext<AuthContextType>({\n  dbUser: null,\n  loading: true,\n  signIn: () => {},\n  signOut: () => {},\n});\n\nexport const AuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {\n  const [dbUser, setDbUser] = useState<User | null>(null);\n  const [loading, setLoading] = useState(true);\n\n  useEffect(() => {\n    const initAuth = async () => {\n      const token = localStorage.getItem(\'token\');\n      if (token) {\n        try {\n          const user = await api.get(\'/api/users/me\');\n          setDbUser(user);\n        } catch (error) {\n          console.error(\"Failed to fetch user, token invalid\");\n          localStorage.removeItem(\'token\');\n          setDbUser(null);\n        }\n      } else {\n        setDbUser(null);\n      }\n      setLoading(false);\n    };\n    initAuth();\n  }, []);\n\n  const signIn = (token: string, user: User) => {\n    localStorage.setItem(\'token\', token);\n    setDbUser(user);\n  };\n\n  const signOut = () => {\n    localStorage.removeItem(\'token\');\n    setDbUser(null);\n  };\n\n  return (\n    <AuthContext.Provider value={{ dbUser, loading, signIn, signOut }}>\n      {children}\n    </AuthContext.Provider>\n  );\n};\n\nexport const useAuth = () => useContext(AuthContext);"
    }
