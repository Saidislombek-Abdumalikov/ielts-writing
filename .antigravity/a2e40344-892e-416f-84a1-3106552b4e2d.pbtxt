    replacement_chunks {
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { api } from \'../lib/api.ts\';\nimport { useNavigate } from \'react-router\';\nimport { motion } from \'motion/react\';\nimport { FileText, Clock, PenTool } from \'lucide-react\';\n\nexport default function StudentDashboard() {\n  const [tasks, setTasks] = useState<any[]>([]);\n  const [loading, setLoading] = useState(true);\n  const navigate = useNavigate();\n\n  useEffect(() => {\n    api.get(\'/api/tasks\').then(data => {\n      setTasks(data);\n      setLoading(false);\n    });\n  }, []);\n\n  if (loading) return <div className=\"text-center py-20 animate-pulse text-slate-400\">Loading assignments...</div>;\n\n  return (\n    <div className=\"space-y-8 animate-fade-up\">\n      <div className=\"flex justify-between items-end\">\n        <div>\n          <h2 className=\"text-3xl font-bold tracking-tight mb-2\">My Assignments</h2>\n          <p className=\"text-slate-400\">Complete your assigned practice tasks.</p>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n        {tasks.map(task => (\n          <motion.div \n            key={task.id}\n            whileHover={{ y: -4 }}\n            className=\"glass-card rounded-2xl p-6 flex flex-col h-full cursor-pointer border-slate-700/50 hover:border-indigo-500/50 transition-colors\"\n            onClick={() => navigate(`/tasks/${task.id}`)}\n          >\n            <div className=\"flex justify-between items-start mb-4\">\n              <span className=\"px-3 py-1 text-xs font-medium bg-indigo-500/10 text-indigo-400 rounded-full border border-indigo-500/20 uppercase tracking-wider\">\n                {task.ieltsType === \'task1\' ? \'Task 1\' : \'Task 2\'}\n              </span>\n              {task.timerMinutes && (\n                <div className=\"flex items-center text-xs text-slate-400 bg-slate-800/50 px-2 py-1 rounded-md\">\n                  <Clock className=\"w-3 h-3 mr-1\" />\n                  {task.timerMinutes}m\n                </div>\n              )}\n            </div>\n            \n            <h3 className=\"text-lg font-semibold mb-2\">{task.title}</h3>\n            <p className=\"text-sm text-slate-400 line-clamp-2 mb-6 flex-1\">\n              {task.promptText}\n            </p>\n            \n            <div className=\"flex items-center justify-between pt-4 border-t border-slate-800\">\n              <span className=\"text-xs text-slate-500\">\n                Due: {new Date(task.dueDate).toLocaleDateString()}\n              </span>\n              <button className=\"text-sm text-indigo-400 font-medium hover:text-indigo-300 flex items-center\">\n                Start <PenTool className=\"w-4 h-4 ml-1\" />\n              </button>\n            </div>\n          </motion.div>\n        ))}\n      </div>\n      \n      {tasks.length === 0 && (\n        <div className=\"text-center py-20 text-slate-500 glass-card rounded-2xl\">\n          <FileText className=\"w-12 h-12 mx-auto mb-4 opacity-50\" />\n          <p>No assignments available at the moment.</p>\n        </div>\n      )}\n    </div>\n  );\n}\n"
    }
