      target_content: "import React, { useEffect, useState } from \'react\';\nimport { useAuth } from \'../components/AuthContext.tsx\';\nimport TeacherDashboard from \'./TeacherDashboard.tsx\';\nimport StudentDashboard from \'./StudentDashboard.tsx\';\n\nexport default function Dashboard() {\n  const { dbUser, signOut } = useAuth();\n\n  return (\n    <div className=\"flex-1 flex flex-col\">\n      <header className=\"glass-header px-6 py-4 flex justify-between items-center sticky top-0 z-50\">\n        <h1 className=\"text-xl font-bold gradient-text\">IELTS Workspace</h1>\n        <div className=\"flex items-center space-x-4\">\n          <span className=\"text-sm text-slate-300\">\n            {dbUser?.name} ({dbUser?.role})\n          </span>\n          <button \n            onClick={signOut}\n            className=\"text-sm px-4 py-2 rounded-lg bg-slate-800/50 hover:bg-slate-700/50 transition-colors border border-slate-700\"\n          >\n            Sign out\n          </button>\n        </div>\n      </header>\n      \n      <main className=\"flex-1 p-6 max-w-7xl mx-auto w-full\">\n        {dbUser?.role === \'teacher\' ? <TeacherDashboard /> : <StudentDashboard />}\n      </main>\n    </div>\n  );\n}"
