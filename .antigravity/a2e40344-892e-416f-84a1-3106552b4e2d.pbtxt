    replacement_chunks {
      target_content: "import React, { useEffect, useState, useRef, useCallback } from \'react\';\nimport { useParams, useNavigate } from \'react-router\';\nimport { api } from \'../lib/api.ts\';\nimport { Clock, Save, Send, AlertTriangle, ChevronLeft } from \'lucide-react\';\n\nexport default function TaskWorkspace() {\n  const { id } = useParams();\n  const navigate = useNavigate();\n  const [task, setTask] = useState<any>(null);\n  const [submission, setSubmission] = useState<any>(null);\n  \n  const [content, setContent] = useState(\'\');\n  const [wordCount, setWordCount] = useState(0);\n  const [pasteCount, setPasteCount] = useState(0);\n  const [isBurst, setIsBurst] = useState(false);\n  const [timeLeft, setTimeLeft] = useState<number | null>(null);\n  \n  const lastKeyTime = useRef<number>(Date.now());\n  const saveTimeout = useRef<any>(null);\n\n  useEffect(() => {\n    // Load task\n    api.get(`/api/tasks/${id}`).then(data => {\n      setTask(data);\n      if (data.timerMinutes) {\n        setTimeLeft(data.timerMinutes * 60);\n      }\n    });\n\n    // Load existing submission\n    api.get(`/api/submissions/${id}/me`)\n      .then(data => {\n        setSubmission(data);\n        setContent(data.content || \'\');\n        setWordCount(data.wordCount || 0);\n      })\n      .catch(() => {\n        // No submission exists yet\n      });\n  }, [id]);\n\n  // Timer countdown\n  useEffect(() => {\n    if (timeLeft === null || submission?.status === \'submitted\' || submission?.status === \'graded\') return;\n    \n    if (timeLeft <= 0) {\n      handleFinalSubmit();\n      return;\n    }\n    \n    const timer = setInterval(() => {\n      setTimeLeft(prev => prev !== null ? prev - 1 : null);\n    }, 1000);\n    \n    return () => clearInterval(timer);\n  }, [timeLeft, submission?.status]);\n\n  const countWords = (text: string) => {\n    return text.trim().split(/\\s+/).filter(w => w.length > 0).length;\n  };\n\n  const handleTextChange = (e: React.ChangeEvent<HTMLTextAreaElement>) => {\n    if (submission?.status === \'submitted\' || submission?.status === \'graded\') return;\n    \n    const newText = e.target.value;\n    setContent(newText);\n    setWordCount(countWords(newText));\n\n    // Anti-cheat: Burst detection\n    const now = Date.now();\n    const timeDiff = now - lastKeyTime.current;\n    if (timeDiff > 0 && timeDiff < 15) { // Suspiciously fast typing (likely macro/paste)\n      setIsBurst(true);\n    }\n    lastKeyTime.current = now;\n\n    // Auto-save logic\n    if (saveTimeout.current) clearTimeout(saveTimeout.current);\n    saveTimeout.current = setTimeout(() => {\n      saveDraft(newText, false);\n    }, 3000);\n  };\n\n  const handlePaste = (e: React.ClipboardEvent) => {\n    e.preventDefault();\n    setPasteCount(prev => prev + 1);\n    // Let them know pasting is blocked\n  };\n\n  const saveDraft = async (textToSave: string, manual = false) => {\n    try {\n      const data = {\n        content: textToSave,\n        wordCount: countWords(textToSave),\n        pasteAttemptCount: pasteCount,\n        suspiciousBurstFlag: isBurst,\n        status: \'draft\'\n      };\n      const saved = await api.post(`/api/submissions/${id}`, data);\n      setSubmission(saved);\n      if (manual) alert(\'Draft saved!\');\n    } catch (error) {\n      console.error(\'Failed to save draft\', error);\n    }\n  };\n\n  const handleFinalSubmit = async () => {\n    if (!window.confirm(\'Are you sure you want to submit your essay? You cannot edit it after submission.\')) return;\n    \n    try {\n      const data = {\n        content,\n        wordCount,\n        pasteAttemptCount: pasteCount,\n        suspiciousBurstFlag: isBurst,\n        status: \'submitted\'\n      };\n      const saved = await api.post(`/api/submissions/${id}`, data);\n      setSubmission(saved);\n      alert(\'Assignment submitted successfully!\');\n      navigate(\'/\');\n    } catch (error) {\n      console.error(\'Failed to submit\', error);\n      alert(\'Failed to submit assignment. Please try again.\');\n    }\n  };\n\n  const formatTime = (seconds: number) => {\n    const m = Math.floor(seconds / 60);\n    const s = seconds % 60;\n    return `${m.toString().padStart(2, \'0\')}:${s.toString().padStart(2, \'0\')}`;\n  };\n\n  if (!task) return <div className=\"p-10 text-center animate-pulse\">Loading workspace...</div>;\n\n  const isReadOnly = submission?.status === \'submitted\' || submission?.status === \'graded\';\n  const targetWords = task.ieltsType === \'task1\' ? 150 : 250;\n  const wordProgress = Math.min((wordCount / targetWords) * 100, 100);\n\n  return (\n    <div className=\"flex flex-col h-screen bg-slate-950\">\n      {/* Header */}\n      <header className=\"glass-header px-6 py-4 flex justify-between items-center shrink-0 shadow-md z-10\">\n        <div className=\"flex items-center space-x-4\">\n          <button onClick={() => navigate(\'/\')} className=\"p-2 rounded-full hover:bg-slate-800 transition-colors\">\n            <ChevronLeft className=\"w-5 h-5 text-slate-400\" />\n          </button>\n          <div>\n            <h1 className=\"text-lg font-bold\">{task.title}</h1>\n            <div className=\"flex items-center space-x-2 text-xs text-slate-400 mt-1\">\n              <span className=\"px-2 py-0.5 rounded bg-indigo-500/10 text-indigo-400 uppercase font-medium\">\n                {task.ieltsType}\n              </span>\n              <span>\342\200\242</span>\n              <span className={`${isReadOnly ? \'text-emerald-400 font-medium\' : \'\'}`}>\n                {isReadOnly ? `Status: ${submission.status}` : \'Draft Mode\'}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"flex items-center space-x-6\">\n          {timeLeft !== null && !isReadOnly && (\n            <div className={`flex items-center px-4 py-2 rounded-xl font-mono text-xl shadow-inner border\n              ${timeLeft < 300 ? \'bg-red-500/10 text-red-400 border-red-500/30 animate-pulse\' : \'bg-slate-900 border-slate-700 text-slate-200\'}`}\n            >\n              <Clock className={`w-5 h-5 mr-2 ${timeLeft < 300 ? \'text-red-400\' : \'text-slate-400\'}`} />\n              {formatTime(timeLeft)}\n            </div>\n          )}\n\n          {!isReadOnly && (\n            <div className=\"flex items-center space-x-3\">\n              <button \n                onClick={() => saveDraft(content, true)}\n                className=\"flex items-center px-4 py-2 text-sm font-medium text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 rounded-xl transition-all\"\n              >\n                <Save className=\"w-4 h-4 mr-2\" /> Save Draft\n              </button>\n              <button \n                onClick={handleFinalSubmit}\n                className=\"flex items-center px-6 py-2 text-sm font-medium text-white gradient-btn rounded-xl shadow-lg\"\n              >\n                <Send className=\"w-4 h-4 mr-2\" /> Submit Essay\n              </button>\n            </div>\n          )}\n        </div>\n      </header>\n\n      {/* Main Workspace Layout */}\n      <div className=\"flex-1 flex overflow-hidden\">\n        {/* Left Panel: Prompt */}\n        <div className=\"w-1/3 min-w-[350px] border-r border-slate-800 bg-slate-900/40 p-6 overflow-y-auto custom-scrollbar flex flex-col\">\n          <h2 className=\"text-xl font-semibold mb-6 flex items-center\">\n            <span className=\"bg-slate-800 p-2 rounded-lg mr-3 shadow-inner\">\360\237\223\235</span>\n            Assignment Details\n          </h2>\n          \n          <div className=\"prose prose-invert prose-slate max-w-none prose-p:leading-relaxed\">\n            <div className=\"p-5 bg-slate-800/50 rounded-xl border border-slate-700 shadow-inner mb-6\">\n              <p className=\"whitespace-pre-wrap text-slate-300 m-0\">{task.promptText}</p>\n            </div>\n            \n            <div className=\"space-y-4\">\n              <h3 className=\"text-sm font-semibold uppercase tracking-wider text-slate-500 mb-2\">Instructions</h3>\n              <ul className=\"text-sm text-slate-400 space-y-2 list-disc pl-4\">\n                <li>You should spend about {task.ieltsType === \'task1\' ? \'20\' : \'40\'} minutes on this task.</li>\n                <li>Write at least {targetWords} words.</li>\n                <li>Your submission is automatically saved as a draft.</li>\n                <li><strong className=\"text-amber-400 flex items-center inline-flex mt-1\"><AlertTriangle className=\"w-3 h-3 mr-1\"/> Anti-Cheat Active:</strong> Pasting text is strictly prohibited and logged.</li>\n              </ul>\n            </div>\n          </div>\n        </div>\n\n        {/* Right Panel: Editor */}\n        <div className=\"flex-1 flex flex-col bg-slate-950 relative\">\n          {isReadOnly && (\n            <div className=\"absolute inset-0 bg-slate-950/40 z-20 pointer-events-none flex items-center justify-center backdrop-blur-[1px]\">\n              {submission.status === \'graded\' ? (\n                <div className=\"bg-slate-900 p-8 rounded-2xl shadow-2xl border border-emerald-500/30 text-center max-w-md mx-4 backdrop-blur-md\">\n                  <div className=\"mx-auto w-16 h-16 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center mb-4 border border-emerald-500/30\">\n                    <span className=\"text-2xl font-bold\">{submission.feedback?.[0]?.bandScore || \'?\'}</span>\n                  </div>\n                  <h3 className=\"text-xl font-bold mb-2\">Essay Graded</h3>\n                  <p className=\"text-slate-400 mb-6\">Your teacher has evaluated this submission.</p>\n                  <button onClick={() => navigate(\'/\')} className=\"w-full px-4 py-2 bg-slate-800 hover:bg-slate-700 rounded-xl text-sm font-medium transition-colors\">Return to Dashboard</button>\n                </div>\n              ) : null}\n            </div>\n          )}\n\n          {/* Editor Header / Stats */}\n          <div className=\"px-8 py-4 border-b border-slate-800/50 bg-slate-900/20 flex items-center justify-between z-10 shrink-0\">\n            <div className=\"w-64\">\n              <div className=\"flex justify-between text-xs font-medium text-slate-400 mb-2\">\n                <span>Words: <strong className={`text-sm ${wordCount >= targetWords ? \'text-emerald-400\' : \'text-slate-200\'}`}>{wordCount}</strong> / {targetWords}</span>\n                {wordCount >= targetWords && <span className=\"text-emerald-400\">Target Reached</span>}\n              </div>\n              <div className=\"h-1.5 w-full bg-slate-800 rounded-full overflow-hidden shadow-inner\">\n                <div \n                  className={`h-full transition-all duration-500 rounded-full ${wordCount >= targetWords ? \'bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.5)]\' : \'bg-indigo-500\'}`}\n                  style={{ width: `${wordProgress}%` }}\n                />\n              </div>\n            </div>\n\n            {pasteCount > 0 && (\n              <div className=\"flex items-center text-xs font-medium text-amber-500 bg-amber-500/10 px-3 py-1.5 rounded-lg border border-amber-500/20 animate-pulse\">\n                <AlertTriangle className=\"w-4 h-4 mr-2\" />\n                {pasteCount} paste attempts logged\n              </div>\n            )}\n          </div>\n\n          {/* Text Area */}\n          <div className=\"flex-1 p-8 overflow-hidden flex flex-col relative\">\n            <textarea\n              className={`w-full h-full flex-1 resize-none bg-transparent text-slate-200 placeholder-slate-600 font-serif text-lg leading-relaxed focus:outline-none custom-scrollbar p-2\n                ${isReadOnly ? \'opacity-75 cursor-not-allowed\' : \'\'}`}\n              placeholder={isReadOnly ? \'\' : \"Start typing your essay here...\"}\n              value={content}\n              onChange={handleTextChange}\n              onPaste={handlePaste}\n              onDrop={(e) => { e.preventDefault(); handlePaste(e as any); }}\n              readOnly={isReadOnly}\n              spellCheck={false}\n            />\n          </div>\n        </div>\n      </div>\n\n      <style>{`\n        .custom-scrollbar::-webkit-scrollbar {\n          width: 8px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-track {\n          background: transparent;\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb {\n          background-color: rgba(71, 85, 105, 0.4);\n          border-radius: 20px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb:hover {\n          background-color: rgba(71, 85, 105, 0.7);\n        }\n      `}</style>\n    </div>\n  );\n}"
      replacement_content: "import React, { useEffect, useState, useRef, useCallback } from \'react\';\nimport { useParams, useNavigate } from \'react-router\';\nimport { api } from \'../lib/api.ts\';\nimport { Clock, Send, AlertTriangle, ChevronLeft } from \'lucide-react\';\n\nexport default function TaskWorkspace() {\n  const { id } = useParams();\n  const navigate = useNavigate();\n  const [task, setTask] = useState<any>(null);\n  const [submission, setSubmission] = useState<any>(null);\n  \n  const [content, setContent] = useState(\'\');\n  const [wordCount, setWordCount] = useState(0);\n  const [pasteCount, setPasteCount] = useState(0);\n  const [isBurst, setIsBurst] = useState(false);\n  \n  const [hasStarted, setHasStarted] = useState(false);\n  const [timeSpentSeconds, setTimeSpentSeconds] = useState(0);\n  const [timeLeft, setTimeLeft] = useState<number | null>(null);\n  \n  const lastKeyTime = useRef<number>(Date.now());\n  const saveTimeout = useRef<any>(null);\n  const hasUnsavedChanges = useRef<boolean>(false);\n\n  useEffect(() => {\n    // Load task\n    api.get(`/api/tasks/${id}`).then(data => {\n      setTask(data);\n      if (data.timerMinutes) {\n        setTimeLeft(data.timerMinutes * 60);\n      }\n    });\n\n    // Load existing submission\n    api.get(`/api/submissions/${id}/me`)\n      .then(data => {\n        setSubmission(data);\n        setContent(data.content || \'\');\n        setWordCount(data.wordCount || 0);\n        if (data.status === \'submitted\' || data.status === \'graded\') {\n          setHasStarted(true);\n        }\n      })\n      .catch(() => {\n        // No submission exists yet\n      });\n  }, [id]);\n\n  const isReadOnly = submission?.status === \'submitted\' || submission?.status === \'graded\';\n\n  // Timer countdown and time spent tracker\n  useEffect(() => {\n    if (!hasStarted || isReadOnly) return;\n    \n    if (timeLeft !== null && timeLeft <= 0) {\n      handleFinalSubmit();\n      return;\n    }\n    \n    const timer = setInterval(() => {\n      setTimeSpentSeconds(prev => prev + 1);\n      if (timeLeft !== null) {\n        setTimeLeft(prev => prev !== null ? prev - 1 : null);\n      }\n    }, 1000);\n    \n    return () => clearInterval(timer);\n  }, [timeLeft, hasStarted, isReadOnly]);\n\n  // Prevent leaving page before submit if started\n  useEffect(() => {\n    const handleBeforeUnload = (e: BeforeUnloadEvent) => {\n      if (hasStarted && !isReadOnly) {\n        e.preventDefault();\n        e.returnValue = \'\';\n      }\n    };\n    window.addEventListener(\'beforeunload\', handleBeforeUnload);\n    return () => window.removeEventListener(\'beforeunload\', handleBeforeUnload);\n  }, [hasStarted, isReadOnly]);\n\n  const countWords = (text: string) => {\n    return text.trim().split(/\\s+/).filter(w => w.length > 0).length;\n  };\n\n  const handleTextChange = (e: React.ChangeEvent<HTMLTextAreaElement>) => {\n    if (isReadOnly) return;\n    \n    const newText = e.target.value;\n    setContent(newText);\n    setWordCount(countWords(newText));\n    hasUnsavedChanges.current = true;\n\n    // Anti-cheat: Burst detection\n    const now = Date.now();\n    const timeDiff = now - lastKeyTime.current;\n    if (timeDiff > 0 && timeDiff < 15) { \n      setIsBurst(true);\n    }\n    lastKeyTime.current = now;\n\n    // Auto-save logic (every 3 seconds)\n    if (saveTimeout.current) clearTimeout(saveTimeout.current);\n    saveTimeout.current = setTimeout(() => {\n      saveDraft(newText, false);\n    }, 3000);\n  };\n\n  const handlePaste = (e: React.ClipboardEvent) => {\n    e.preventDefault();\n    setPasteCount(prev => prev + 1);\n  };\n\n  const handleCopyCut = (e: React.ClipboardEvent) => {\n    e.preventDefault();\n  };\n\n  const saveDraft = async (textToSave: string, isFinal = false) => {\n    try {\n      const data = {\n        content: textToSave,\n        wordCount: countWords(textToSave),\n        pasteAttemptCount: pasteCount,\n        suspiciousBurstFlag: isBurst,\n        status: isFinal ? \'submitted\' : \'draft\'\n      };\n      const saved = await api.post(`/api/submissions/${id}`, data);\n      setSubmission(saved);\n      hasUnsavedChanges.current = false;\n    } catch (error) {\n      console.error(\'Failed to save\', error);\n    }\n  };\n\n  const minMinutes = task?.minTimerMinutes || 0;\n  const canSubmit = timeSpentSeconds >= (minMinutes * 60);\n\n  const handleFinalSubmit = async () => {\n    if (!canSubmit && timeLeft !== null && timeLeft > 0) {\n      alert(`You must spend at least ${minMinutes} minutes before submitting.`);\n      return;\n    }\n    if (!window.confirm(\'Are you sure you want to submit your essay? You cannot edit it after submission.\')) return;\n    \n    await saveDraft(content, true);\n    alert(\'Assignment submitted successfully!\');\n    navigate(\'/\');\n  };\n\n  const handleExitAttempt = () => {\n    if (hasStarted && !isReadOnly) {\n      if (window.confirm(\'You have an active assignment. Leaving now will keep it as a draft, but the timer will continue. Are you sure you want to leave?\')) {\n        saveDraft(content, false).then(() => navigate(\'/\'));\n      }\n    } else {\n      navigate(\'/\');\n    }\n  };\n\n  const formatTime = (seconds: number) => {\n    const m = Math.floor(seconds / 60);\n    const s = seconds % 60;\n    return `${m.toString().padStart(2, \'0\')}:${s.toString().padStart(2, \'0\')}`;\n  };\n\n  if (!task) return <div className=\"p-10 text-center animate-pulse text-slate-400\">Loading workspace...</div>;\n\n  const targetWords = task.ieltsType === \'task1\' ? 150 : 250;\n  const wordProgress = Math.min((wordCount / targetWords) * 100, 100);\n\n  if (!hasStarted) {\n    return (\n      <div className=\"min-h-screen bg-slate-950 flex items-center justify-center p-4\">\n        <div className=\"glass-card max-w-lg w-full p-8 rounded-2xl text-center\">\n          <h1 className=\"text-2xl font-bold mb-4\">{task.title}</h1>\n          <p className=\"text-slate-400 mb-6\">You are about to start this assignment.</p>\n          <ul className=\"text-left text-slate-300 space-y-3 mb-8 bg-slate-900/50 p-6 rounded-xl border border-slate-800\">\n            <li className=\"flex items-start\"><AlertTriangle className=\"w-5 h-5 text-amber-500 mr-3 shrink-0\" /> Your essay will be automatically saved every 3 seconds.</li>\n            <li className=\"flex items-start\"><AlertTriangle className=\"w-5 h-5 text-amber-500 mr-3 shrink-0\" /> Copying, cutting, and pasting text is strictly blocked and monitored.</li>\n            <li className=\"flex items-start\"><Clock className=\"w-5 h-5 text-indigo-400 mr-3 shrink-0\" /> Maximum time: {task.timerMinutes} minutes.</li>\n            <li className=\"flex items-start\"><Clock className=\"w-5 h-5 text-indigo-400 mr-3 shrink-0\" /> Minimum time before submit: {task.minTimerMinutes} minutes.</li>\n            <li className=\"flex items-start\"><AlertTriangle className=\"w-5 h-5 text-red-400 mr-3 shrink-0\" /> Do not close or leave the tab until you have successfully submitted your essay.</li>\n          </ul>\n          <div className=\"flex justify-center space-x-4\">\n            <button onClick={() => navigate(\'/\')} className=\"px-6 py-3 rounded-xl text-slate-300 hover:bg-slate-800 transition-colors\">Go Back</button>\n            <button onClick={() => setHasStarted(true)} className=\"gradient-btn px-8 py-3 rounded-xl font-medium shadow-lg shadow-indigo-500/20 text-lg\">Start Assignment</button>\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"flex flex-col h-screen bg-slate-950\">\n      {/* Header */}\n      <header className=\"glass-header px-6 py-4 flex justify-between items-center shrink-0 shadow-md z-10\">\n        <div className=\"flex items-center space-x-4\">\n          <button onClick={handleExitAttempt} className=\"p-2 rounded-full hover:bg-slate-800 transition-colors\">\n            <ChevronLeft className=\"w-5 h-5 text-slate-400\" />\n          </button>\n          <div>\n            <h1 className=\"text-lg font-bold\">{task.title}</h1>\n            <div className=\"flex items-center space-x-2 text-xs text-slate-400 mt-1\">\n              <span className=\"px-2 py-0.5 rounded bg-indigo-500/10 text-indigo-400 uppercase font-medium\">\n                {task.ieltsType}\n              </span>\n              <span>\342\200\242</span>\n              <span className={`${isReadOnly ? \'text-emerald-400 font-medium\' : \'\'}`}>\n                {isReadOnly ? `Status: ${submission?.status || \'submitted\'}` : \'Writing Mode (Auto-saving...)\'}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        <div className=\"flex items-center space-x-6\">\n          {timeLeft !== null && !isReadOnly && (\n            <div className={`flex items-center px-4 py-2 rounded-xl font-mono text-xl shadow-inner border\n              ${timeLeft < 300 ? \'bg-red-500/10 text-red-400 border-red-500/30 animate-pulse\' : \'bg-slate-900 border-slate-700 text-slate-200\'}`}\n            >\n              <Clock className={`w-5 h-5 mr-2 ${timeLeft < 300 ? \'text-red-400\' : \'text-slate-400\'}`} />\n              {formatTime(timeLeft)}\n            </div>\n          )}\n\n          {!isReadOnly && (\n            <div className=\"flex items-center space-x-3\">\n              <button \n                onClick={handleFinalSubmit}\n                disabled={!canSubmit && timeLeft !== null && timeLeft > 0}\n                className={`flex items-center px-6 py-2 text-sm font-medium text-white rounded-xl shadow-lg transition-all\n                  ${canSubmit || (timeLeft !== null && timeLeft <= 0) ? \'gradient-btn\' : \'bg-slate-800 text-slate-500 cursor-not-allowed opacity-50\'}`}\n                title={!canSubmit ? `You must write for at least ${minMinutes} minutes before submitting` : \'\'}\n              >\n                <Send className=\"w-4 h-4 mr-2\" /> Submit Essay\n              </button>\n            </div>\n          )}\n        </div>\n      </header>\n\n      {/* Main Workspace Layout */}\n      <div className=\"flex-1 flex overflow-hidden\">\n        {/* Left Panel: Prompt */}\n        <div className=\"w-1/3 min-w-[350px] border-r border-slate-800 bg-slate-900/40 p-6 overflow-y-auto custom-scrollbar flex flex-col\">\n          <h2 className=\"text-xl font-semibold mb-6 flex items-center\">\n            <span className=\"bg-slate-800 p-2 rounded-lg mr-3 shadow-inner\">\360\237\223\235</span>\n            Assignment Details\n          </h2>\n          \n          <div className=\"prose prose-invert prose-slate max-w-none prose-p:leading-relaxed\">\n            {task.imageUrl && (\n              <div className=\"mb-6 rounded-xl overflow-hidden border border-slate-700 bg-slate-800/50\">\n                <img src={task.imageUrl} alt=\"Assignment Reference\" className=\"w-full h-auto object-contain\" />\n              </div>\n            )}\n            \n            <div className=\"p-5 bg-slate-800/50 rounded-xl border border-slate-700 shadow-inner mb-6\">\n              <p className=\"whitespace-pre-wrap text-slate-300 m-0\">{task.promptText}</p>\n            </div>\n            \n            {task.assignmentMode === \'partly\' && task.focusLabel && (\n              <div className=\"p-4 bg-indigo-500/10 border border-indigo-500/30 rounded-xl mb-6\">\n                <h3 className=\"text-indigo-400 font-semibold mb-1 text-sm uppercase tracking-wider\">Focus Area</h3>\n                <p className=\"text-indigo-200\">{task.focusLabel}</p>\n              </div>\n            )}\n            \n            <div className=\"space-y-4 mt-8\">\n              <h3 className=\"text-sm font-semibold uppercase tracking-wider text-slate-500 mb-2\">Instructions</h3>\n              <ul className=\"text-sm text-slate-400 space-y-2 list-disc pl-4\">\n                <li>You should spend about {task.ieltsType === \'task1\' ? \'20\' : \'40\'} minutes on this task.</li>\n                <li>Write at least {targetWords} words.</li>\n                <li><strong className=\"text-amber-400 flex items-center inline-flex mt-1\"><AlertTriangle className=\"w-3 h-3 mr-1\"/> Strict Mode Active:</strong> Your essay is auto-saved. Pasting and copying are blocked.</li>\n              </ul>\n            </div>\n          </div>\n        </div>\n\n        {/* Right Panel: Editor */}\n        <div className=\"flex-1 flex flex-col bg-slate-950 relative\">\n          {isReadOnly && (\n            <div className=\"absolute inset-0 bg-slate-950/40 z-20 pointer-events-none flex items-center justify-center backdrop-blur-[1px]\">\n              {submission?.status === \'graded\' ? (\n                <div className=\"bg-slate-900 p-8 rounded-2xl shadow-2xl border border-emerald-500/30 text-center max-w-md mx-4 backdrop-blur-md pointer-events-auto\">\n                  <div className=\"mx-auto w-16 h-16 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center mb-4 border border-emerald-500/30\">\n                    <span className=\"text-2xl font-bold\">{submission.feedback?.[0]?.bandScore || \'?\'}</span>\n                  </div>\n                  <h3 className=\"text-xl font-bold mb-2\">Essay Graded</h3>\n                  <p className=\"text-slate-400 mb-6\">Your teacher has evaluated this submission.</p>\n                  <button onClick={() => navigate(\'/\')} className=\"w-full px-4 py-2 bg-slate-800 hover:bg-slate-700 rounded-xl text-sm font-medium transition-colors\">Return to Dashboard</button>\n                </div>\n              ) : (\n                 <div className=\"bg-slate-900 p-8 rounded-2xl shadow-2xl border border-slate-700 text-center max-w-md mx-4 backdrop-blur-md pointer-events-auto\">\n                  <h3 className=\"text-xl font-bold mb-2\">Assignment Submitted</h3>\n                  <p className=\"text-slate-400 mb-6\">You cannot edit this assignment anymore. Waiting for teacher\'s feedback.</p>\n                  <button onClick={() => navigate(\'/\')} className=\"w-full px-4 py-2 bg-slate-800 hover:bg-slate-700 rounded-xl text-sm font-medium transition-colors\">Return to Dashboard</button>\n                </div>\n              )}\n            </div>\n          )}\n\n          {/* Editor Header / Stats */}\n          <div className=\"px-8 py-4 border-b border-slate-800/50 bg-slate-900/20 flex items-center justify-between z-10 shrink-0\">\n            <div className=\"w-64\">\n              <div className=\"flex justify-between text-xs font-medium text-slate-400 mb-2\">\n                <span>Words: <strong className={`text-sm ${wordCount >= targetWords ? \'text-emerald-400\' : \'text-slate-200\'}`}>{wordCount}</strong> / {targetWords}</span>\n                {wordCount >= targetWords && <span className=\"text-emerald-400\">Target Reached</span>}\n              </div>\n              <div className=\"h-1.5 w-full bg-slate-800 rounded-full overflow-hidden shadow-inner\">\n                <div \n                  className={`h-full transition-all duration-500 rounded-full ${wordCount >= targetWords ? \'bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.5)]\' : \'bg-indigo-500\'}`}\n                  style={{ width: `${wordProgress}%` }}\n                />\n              </div>\n            </div>\n\n            {pasteCount > 0 && (\n              <div className=\"flex items-center text-xs font-medium text-amber-500 bg-amber-500/10 px-3 py-1.5 rounded-lg border border-amber-500/20 animate-pulse\">\n                <AlertTriangle className=\"w-4 h-4 mr-2\" />\n                {pasteCount} paste attempts logged\n              </div>\n            )}\n          </div>\n\n          {/* Text Area */}\n          <div className=\"flex-1 p-8 overflow-hidden flex flex-col relative\">\n            <textarea\n              className={`w-full h-full flex-1 resize-none bg-transparent text-slate-200 placeholder-slate-600 font-serif text-lg leading-relaxed focus:outline-none custom-scrollbar p-2\n                ${isReadOnly ? \'opacity-75 cursor-not-allowed\' : \'\'}`}\n              placeholder={isReadOnly ? \'\' : \"Start typing your essay here...\"}\n              value={content}\n              onChange={handleTextChange}\n              onPaste={handlePaste}\n              onCopy={handleCopyCut}\n              onCut={handleCopyCut}\n              onDrop={(e) => { e.preventDefault(); handlePaste(e as any); }}\n              readOnly={isReadOnly}\n              spellCheck={false}\n            />\n          </div>\n        </div>\n      </div>\n\n      <style>{`\n        .custom-scrollbar::-webkit-scrollbar {\n          width: 8px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-track {\n          background: transparent;\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb {\n          background-color: rgba(71, 85, 105, 0.4);\n          border-radius: 20px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb:hover {\n          background-color: rgba(71, 85, 105, 0.7);\n        }\n      `}</style>\n    </div>\n  );\n}"
