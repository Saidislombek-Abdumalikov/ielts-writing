      target_content: "import React, { useEffect, useState } from \'react\';\nimport { api } from \'../lib/api.ts\';\nimport { useNavigate } from \'react-router\';\nimport { motion } from \'motion/react\';\nimport { Plus, Users, BookOpen, Clock } from \'lucide-react\';\n\nexport default function TeacherDashboard() {\n  const [tasks, setTasks] = useState<any[]>([]);\n  const [showCreate, setShowCreate] = useState(false);\n  const [newTask, setNewTask] = useState({\n    title: \'\',\n    ieltsType: \'task2\',\n    promptText: \'\',\n    timerMinutes: 40,\n    dueDate: new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString().slice(0, 16)\n  });\n  \n  const navigate = useNavigate();\n\n  const loadTasks = () => {\n    api.get(\'/api/tasks\').then(setTasks);\n  };\n\n  useEffect(() => {\n    loadTasks();\n  }, []);\n\n  const handleCreate = async (e: React.FormEvent) => {\n    e.preventDefault();\n    await api.post(\'/api/tasks\', newTask);\n    setShowCreate(false);\n    loadTasks();\n    setNewTask({ ...newTask, title: \'\', promptText: \'\' });\n  };\n\n  return (\n    <div className=\"space-y-8 animate-fade-up\">\n      <div className=\"flex justify-between items-end\">\n        <div>\n          <h2 className=\"text-3xl font-bold tracking-tight mb-2\">Teacher Dashboard</h2>\n          <p className=\"text-slate-400\">Manage assignments and evaluate submissions.</p>\n        </div>\n        <button \n          onClick={() => setShowCreate(!showCreate)}\n          className=\"gradient-btn px-4 py-2 rounded-xl text-sm font-medium flex items-center shadow-lg\"\n        >\n          <Plus className=\"w-4 h-4 mr-2\" />\n          Create Task\n        </button>\n      </div>\n\n      {showCreate && (\n        <motion.form \n          initial={{ opacity: 0, height: 0 }}\n          animate={{ opacity: 1, height: \'auto\' }}\n          className=\"glass-card p-6 rounded-2xl overflow-hidden\"\n          onSubmit={handleCreate}\n        >\n          <h3 className=\"text-xl font-semibold mb-6\">New Assignment</h3>\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 mb-6\">\n            <div className=\"space-y-4\">\n              <div>\n                <label className=\"block text-sm text-slate-400 mb-1\">Title</label>\n                <input required className=\"w-full glass-input px-4 py-2 rounded-lg\" value={newTask.title} onChange={e => setNewTask({...newTask, title: e.target.value})} placeholder=\"e.g. Academic Task 1 - Bar Chart\" />\n              </div>\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"block text-sm text-slate-400 mb-1\">Task Type</label>\n                  <select className=\"w-full glass-input px-4 py-2 rounded-lg appearance-none\" value={newTask.ieltsType} onChange={e => setNewTask({...newTask, ieltsType: e.target.value})}>\n                    <option value=\"task1\">Task 1 (150 words)</option>\n                    <option value=\"task2\">Task 2 (250 words)</option>\n                  </select>\n                </div>\n                <div>\n                  <label className=\"block text-sm text-slate-400 mb-1\">Timer (minutes)</label>\n                  <input type=\"number\" required className=\"w-full glass-input px-4 py-2 rounded-lg\" value={newTask.timerMinutes} onChange={e => setNewTask({...newTask, timerMinutes: parseInt(e.target.value)})} />\n                </div>\n              </div>\n              <div>\n                <label className=\"block text-sm text-slate-400 mb-1\">Due Date</label>\n                <input type=\"datetime-local\" required className=\"w-full glass-input px-4 py-2 rounded-lg\" value={newTask.dueDate} onChange={e => setNewTask({...newTask, dueDate: e.target.value})} />\n              </div>\n            </div>\n            \n            <div className=\"h-full flex flex-col\">\n              <label className=\"block text-sm text-slate-400 mb-1\">Prompt / Question</label>\n              <textarea required className=\"w-full h-full min-h-[160px] glass-input px-4 py-3 rounded-lg resize-none\" value={newTask.promptText} onChange={e => setNewTask({...newTask, promptText: e.target.value})} placeholder=\"Enter the exact essay prompt...\" />\n            </div>\n          </div>\n          \n          <div className=\"flex justify-end space-x-3\">\n            <button type=\"button\" onClick={() => setShowCreate(false)} className=\"px-4 py-2 rounded-xl text-sm font-medium hover:bg-slate-800 transition-colors\">Cancel</button>\n            <button type=\"submit\" className=\"gradient-btn px-6 py-2 rounded-xl text-sm font-medium\">Publish Task</button>\n          </div>\n        </motion.form>\n      )}\n\n      <div className=\"grid grid-cols-1 mb-10\">\n        <h3 className=\"text-xl font-semibold mb-4\">Active Assignments</h3>\n        <div className=\"glass-card rounded-2xl overflow-hidden\">\n          <table className=\"w-full text-left border-collapse\">\n            <thead>\n              <tr className=\"border-b border-slate-800 text-sm text-slate-400 bg-slate-900/50\">\n                <th className=\"px-6 py-4 font-medium\">Title</th>\n                <th className=\"px-6 py-4 font-medium\">Type</th>\n                <th className=\"px-6 py-4 font-medium\">Due Date</th>\n                <th className=\"px-6 py-4 font-medium text-right\">Actions</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800/50\">\n              {tasks.map(task => (\n                <tr key={task.id} className=\"hover:bg-slate-800/20 transition-colors\">\n                  <td className=\"px-6 py-4 font-medium\">{task.title}</td>\n                  <td className=\"px-6 py-4\">\n                    <span className=\"px-2 py-1 text-xs rounded bg-slate-800 text-slate-300 uppercase tracking-wider\">\n                      {task.ieltsType}\n                    </span>\n                  </td>\n                  <td className=\"px-6 py-4 text-slate-400 text-sm\">\n                    {new Date(task.dueDate).toLocaleDateString()}\n                  </td>\n                  <td className=\"px-6 py-4 text-right\">\n                    <button \n                      onClick={() => navigate(`/teacher/submissions/${task.id}`)}\n                      className=\"text-sm font-medium text-indigo-400 hover:text-indigo-300 transition-colors flex items-center justify-end w-full\"\n                    >\n                      <Users className=\"w-4 h-4 mr-2\" />\n                      View Submissions\n                    </button>\n                  </td>\n                </tr>\n              ))}\n              {tasks.length === 0 && (\n                <tr>\n                  <td colSpan={4} className=\"px-6 py-10 text-center text-slate-500\">\n                    No assignments published yet.\n                  </td>\n                </tr>\n              )}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n}"
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { api } from \'../lib/api.ts\';\nimport { useNavigate } from \'react-router\';\nimport { motion } from \'motion/react\';\nimport { Plus, Users, Search, Edit2, Trash2, Link as LinkIcon } from \'lucide-react\';\n\nexport default function TeacherDashboard() {\n  const [tasks, setTasks] = useState<any[]>([]);\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [showCreate, setShowCreate] = useState(false);\n  const [editingTask, setEditingTask] = useState<number | null>(null);\n  \n  const defaultTask = {\n    title: \'\',\n    ieltsType: \'task2\',\n    assignmentMode: \'full\',\n    focusLabel: \'\',\n    imageUrl: \'\',\n    promptText: \'\',\n    timerMinutes: 40,\n    minTimerMinutes: 30,\n    dueDate: new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toISOString().slice(0, 16)\n  };\n  \n  const [newTask, setNewTask] = useState(defaultTask);\n  const navigate = useNavigate();\n\n  const loadTasks = () => {\n    api.get(\'/api/tasks\').then(setTasks);\n  };\n\n  useEffect(() => {\n    loadTasks();\n  }, []);\n\n  const handleCreateOrUpdate = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (editingTask) {\n      await api.put(`/api/tasks/${editingTask}`, newTask);\n    } else {\n      await api.post(\'/api/tasks\', newTask);\n    }\n    setShowCreate(false);\n    setEditingTask(null);\n    loadTasks();\n    setNewTask(defaultTask);\n  };\n\n  const handleEdit = (task: any) => {\n    setNewTask({\n      title: task.title,\n      ieltsType: task.ieltsType,\n      assignmentMode: task.assignmentMode || \'full\',\n      focusLabel: task.focusLabel || \'\',\n      imageUrl: task.imageUrl || \'\',\n      promptText: task.promptText,\n      timerMinutes: task.timerMinutes || 40,\n      minTimerMinutes: task.minTimerMinutes || 30,\n      dueDate: new Date(task.dueDate).toISOString().slice(0, 16)\n    });\n    setEditingTask(task.id);\n    setShowCreate(true);\n  };\n\n  const handleDelete = async (id: number) => {\n    if (confirm(\'Are you sure you want to delete this assignment and all its submissions?\')) {\n      await api.delete(`/api/tasks/${id}`);\n      loadTasks();\n    }\n  };\n\n  const filteredTasks = tasks.filter(t => \n    t.title.toLowerCase().includes(searchQuery.toLowerCase()) || \n    t.ieltsType.toLowerCase().includes(searchQuery.toLowerCase())\n  );\n\n  return (\n    <div className=\"space-y-8 animate-fade-up\">\n      <div className=\"flex flex-col md:flex-row md:justify-between md:items-end gap-4\">\n        <div>\n          <h2 className=\"text-3xl font-bold tracking-tight mb-2\">Teacher Dashboard</h2>\n          <p className=\"text-slate-400\">Manage assignments and evaluate submissions.</p>\n        </div>\n        \n        <div className=\"flex items-center space-x-4\">\n          <div className=\"relative\">\n            <Search className=\"w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400\" />\n            <input \n              type=\"text\" \n              placeholder=\"Search assignments...\" \n              className=\"glass-input pl-9 pr-4 py-2 rounded-xl text-sm w-64\"\n              value={searchQuery}\n              onChange={e => setSearchQuery(e.target.value)}\n            />\n          </div>\n          \n          <button \n            onClick={() => {\n              setShowCreate(!showCreate);\n              if (editingTask) {\n                setEditingTask(null);\n                setNewTask(defaultTask);\n              }\n            }}\n            className=\"gradient-btn px-4 py-2 rounded-xl text-sm font-medium flex items-center shadow-lg whitespace-nowrap\"\n          >\n            <Plus className=\"w-4 h-4 mr-2\" />\n            Create Task\n          </button>\n        </div>\n      </div>\n\n      {showCreate && (\n        <motion.form \n          initial={{ opacity: 0, height: 0 }}\n          animate={{ opacity: 1, height: \'auto\' }}\n          className=\"glass-card p-6 rounded-2xl overflow-hidden\"\n          onSubmit={handleCreateOrUpdate}\n        >\n          <h3 className=\"text-xl font-semibold mb-6\">{editingTask ? \'Edit Assignment\' : \'New Assignment\'}</h3>\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 mb-6\">\n            <div className=\"space-y-4\">\n              <div>\n                <label className=\"block text-sm text-slate-400 mb-1\">Title</label>\n                <input required className=\"w-full glass-input px-4 py-2 rounded-lg\" value={newTask.title} onChange={e => setNewTask({...newTask, title: e.target.value})} placeholder=\"e.g. Academic Task 1 - Bar Chart\" />\n              </div>\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"block text-sm text-slate-400 mb-1\">Task Type</label>\n                  <select className=\"w-full glass-input px-4 py-2 rounded-lg appearance-none\" value={newTask.ieltsType} onChange={e => setNewTask({...newTask, ieltsType: e.target.value})}>\n                    <option value=\"task1\">Task 1 (150 words)</option>\n                    <option value=\"task2\">Task 2 (250 words)</option>\n                  </select>\n                </div>\n                <div>\n                  <label className=\"block text-sm text-slate-400 mb-1\">Assignment Mode</label>\n                  <select className=\"w-full glass-input px-4 py-2 rounded-lg appearance-none\" value={newTask.assignmentMode} onChange={e => setNewTask({...newTask, assignmentMode: e.target.value})}>\n                    <option value=\"full\">Full Essay</option>\n                    <option value=\"partly\">Partly (e.g. Intro only)</option>\n                  </select>\n                </div>\n              </div>\n              \n              {newTask.assignmentMode === \'partly\' && (\n                <div>\n                  <label className=\"block text-sm text-slate-400 mb-1\">Focus Area (e.g., Intro + Overview)</label>\n                  <input className=\"w-full glass-input px-4 py-2 rounded-lg\" value={newTask.focusLabel} onChange={e => setNewTask({...newTask, focusLabel: e.target.value})} placeholder=\"e.g. Write Introduction and Overview\" />\n                </div>\n              )}\n\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div>\n                  <label className=\"block text-sm text-slate-400 mb-1\">Max Timer (minutes)</label>\n                  <input type=\"number\" required className=\"w-full glass-input px-4 py-2 rounded-lg\" value={newTask.timerMinutes} onChange={e => setNewTask({...newTask, timerMinutes: parseInt(e.target.value)})} />\n                </div>\n                <div>\n                  <label className=\"block text-sm text-slate-400 mb-1\">Min Timer (minutes)</label>\n                  <input type=\"number\" required className=\"w-full glass-input px-4 py-2 rounded-lg\" value={newTask.minTimerMinutes} onChange={e => setNewTask({...newTask, minTimerMinutes: parseInt(e.target.value)})} />\n                </div>\n              </div>\n              \n              <div>\n                <label className=\"block text-sm text-slate-400 mb-1\">Due Date</label>\n                <input type=\"datetime-local\" required className=\"w-full glass-input px-4 py-2 rounded-lg\" value={newTask.dueDate} onChange={e => setNewTask({...newTask, dueDate: e.target.value})} />\n              </div>\n            </div>\n            \n            <div className=\"h-full flex flex-col space-y-4\">\n              <div>\n                <label className=\"block text-sm text-slate-400 mb-1 flex items-center\">\n                  <LinkIcon className=\"w-3 h-3 mr-1\" /> Image URL (Optional, for Task 1)\n                </label>\n                <input type=\"url\" className=\"w-full glass-input px-4 py-2 rounded-lg text-sm\" value={newTask.imageUrl} onChange={e => setNewTask({...newTask, imageUrl: e.target.value})} placeholder=\"https://example.com/chart.png\" />\n              </div>\n              \n              <div className=\"flex-1 flex flex-col\">\n                <label className=\"block text-sm text-slate-400 mb-1\">Prompt / Question</label>\n                <textarea required className=\"w-full h-full min-h-[160px] glass-input px-4 py-3 rounded-lg resize-none\" value={newTask.promptText} onChange={e => setNewTask({...newTask, promptText: e.target.value})} placeholder=\"Enter the exact essay prompt...\" />\n              </div>\n            </div>\n          </div>\n          \n          <div className=\"flex justify-end space-x-3\">\n            <button type=\"button\" onClick={() => { setShowCreate(false); setEditingTask(null); setNewTask(defaultTask); }} className=\"px-4 py-2 rounded-xl text-sm font-medium hover:bg-slate-800 transition-colors\">Cancel</button>\n            <button type=\"submit\" className=\"gradient-btn px-6 py-2 rounded-xl text-sm font-medium\">{editingTask ? \'Update Task\' : \'Publish Task\'}</button>\n          </div>\n        </motion.form>\n      )}\n\n      <div className=\"grid grid-cols-1 mb-10\">\n        <h3 className=\"text-xl font-semibold mb-4 flex items-center justify-between\">\n          <span>Active Assignments</span>\n          <span className=\"text-sm font-normal text-slate-400\">{filteredTasks.length} tasks</span>\n        </h3>\n        <div className=\"glass-card rounded-2xl overflow-hidden\">\n          <table className=\"w-full text-left border-collapse\">\n            <thead>\n              <tr className=\"border-b border-slate-800 text-sm text-slate-400 bg-slate-900/50\">\n                <th className=\"px-6 py-4 font-medium\">Title</th>\n                <th className=\"px-6 py-4 font-medium\">Type & Mode</th>\n                <th className=\"px-6 py-4 font-medium\">Due Date</th>\n                <th className=\"px-6 py-4 font-medium text-right\">Actions</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800/50\">\n              {filteredTasks.map(task => (\n                <tr key={task.id} className=\"hover:bg-slate-800/20 transition-colors\">\n                  <td className=\"px-6 py-4 font-medium\">{task.title}</td>\n                  <td className=\"px-6 py-4\">\n                    <div className=\"flex items-center space-x-2\">\n                      <span className=\"px-2 py-1 text-xs rounded bg-slate-800 text-slate-300 uppercase tracking-wider\">\n                        {task.ieltsType}\n                      </span>\n                      {task.assignmentMode === \'partly\' && (\n                        <span className=\"px-2 py-1 text-xs rounded bg-indigo-500/20 text-indigo-300 border border-indigo-500/30\">\n                          Partly\n                        </span>\n                      )}\n                    </div>\n                  </td>\n                  <td className=\"px-6 py-4 text-slate-400 text-sm\">\n                    {new Date(task.dueDate).toLocaleDateString()}\n                  </td>\n                  <td className=\"px-6 py-4 text-right flex items-center justify-end space-x-3\">\n                    <button \n                      onClick={() => navigate(`/teacher/submissions/${task.id}`)}\n                      className=\"text-sm font-medium text-indigo-400 hover:text-indigo-300 transition-colors flex items-center\"\n                      title=\"View Submissions\"\n                    >\n                      <Users className=\"w-4 h-4\" />\n                    </button>\n                    <button \n                      onClick={() => handleEdit(task)}\n                      className=\"text-sm font-medium text-slate-400 hover:text-white transition-colors flex items-center\"\n                      title=\"Edit Task\"\n                    >\n                      <Edit2 className=\"w-4 h-4\" />\n                    </button>\n                    <button \n                      onClick={() => handleDelete(task.id)}\n                      className=\"text-sm font-medium text-red-400 hover:text-red-300 transition-colors flex items-center\"\n                      title=\"Delete Task\"\n                    >\n                      <Trash2 className=\"w-4 h-4\" />\n                    </button>\n                  </td>\n                </tr>\n              ))}\n              {filteredTasks.length === 0 && (\n                <tr>\n                  <td colSpan={4} className=\"px-6 py-10 text-center text-slate-500\">\n                    No assignments found.\n                  </td>\n                </tr>\n              )}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n}"
    }
