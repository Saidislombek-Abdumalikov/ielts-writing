steps {
  type: CORTEX_STEP_TYPE_USER_INPUT
  status: CORTEX_STEP_STATUS_DONE
  metadata {
    created_at {
      seconds: 1786025416
      nanos: 190119513
    }
    source: CORTEX_STEP_SOURCE_USER_EXPLICIT
  }
  user_input {
    user_response: "markdown\n\n\n# Application Name & Overview\n**IELTS Writing Homework Platform**\nAn exam-focused, real-time web application designed for IELTS preparation centers and tutors. It enables teachers to publish Task 1 & Task 2 writing assignments (both full essays and partial section practice), track student progress with strict anti-cheat monitoring (paste blocking and typing burst detection), and evaluate submitted essays with criteria-based band scores and detailed commentary.\n---\n# Key Functional Requirements\n### 1. Dual User Roles\n- **Teacher**: Publishes assignments (timers, due dates, Task 1 chart URLs, Task 2 essay prompts, section focus labels), creates student login IDs, resets credentials, tracks submission statuses, and evaluates essays.\n- **Student**: Logs in via a simple username ID, views assigned tasks, writes essays in an anti-cheat environment with live word counters and exam countdown timers, saves drafts, and reviews graded submission history.\n### 2. Anti-Cheat Writing Workspace (`/tasks/[id]`)\n- **Clipboard Protection**: Intercepts `onPaste` and `onDrop` events on the text editor, incrementing a `pasteAttemptCount` flag.\n- **Typing Burst Detection**: Monitors keystroke velocity (<15ms gap between keys) to flag automated macro injection.\n- **Live Exam Clock**: Countdown timer that automatically locks and submits the essay when time expires.\n- **Target Indicators**: Highlights progress against target word counts (150 words for Task 1; 250 words for Task 2).\n### 3. Evaluation Workspace (`/teacher/submissions/[id]`)\n- Side-by-side essay reader and instructor feedback card.\n- Quick band score selector pills (`5.0`, `5.5`, `6.0`, `6.5`, `7.0`, `7.5`, `8.0`, `8.5`, `9.0`).\n- Detailed commentary field for Task Response, Coherence & Cohesion, Lexical Resource, and Grammatical Range.\n---\n# Code Snippets & Architecture\n### 1. Database Schema (`src/db/schema.ts`)\n```typescript\nimport { boolean, integer, pgTable, serial, text, timestamp, varchar } from \"drizzle-orm/pg-core\";\nexport const users = pgTable(\"users\", {\n  id: serial(\"id\").primaryKey(),\n  name: text(\"name\").notNull(),\n  username: varchar(\"username\", { length: 100 }).unique(),\n  email: varchar(\"email\", { length: 255 }),\n  passwordHash: text(\"password_hash\").notNull(),\n  role: varchar(\"role\", { length: 20 }).notNull().default(\"student\"),\n  createdAt: timestamp(\"created_at\").defaultNow().notNull(),\n});\nexport const tasks = pgTable(\"tasks\", {\n  id: serial(\"id\").primaryKey(),\n  teacherId: integer(\"teacher_id\").references(() => users.id).notNull(),\n  title: text(\"title\").notNull(),\n  ieltsType: varchar(\"ielts_type\", { length: 20 }).notNull().default(\"task2\"),\n  assignmentMode: varchar(\"assignment_mode\", { length: 20 }).notNull().default(\"full\"),\n  focusLabel: text(\"focus_label\"),\n  promptText: text(\"prompt_text\").notNull(),\n  imageUrl: text(\"image_url\"),\n  timerMinutes: integer(\"timer_minutes\"),\n  dueDate: timestamp(\"due_date\").notNull(),\n  createdAt: timestamp(\"created_at\").defaultNow().notNull(),\n});\nexport const submissions = pgTable(\"submissions\", {\n  id: serial(\"id\").primaryKey(),\n  taskId: integer(\"task_id\").references(() => tasks.id).notNull(),\n  studentId: integer(\"student_id\").references(() => users.id).notNull(),\n  status: varchar(\"status\", { length: 20 }).notNull().default(\"draft\"),\n  content: text(\"content\").notNull().default(\"\"),\n  wordCount: integer(\"word_count\").notNull().default(0),\n  pasteAttemptCount: integer(\"paste_attempt_count\").notNull().default(0),\n  suspiciousBurstFlag: boolean(\"suspicious_burst_flag\").notNull().default(false),\n  submittedAt: timestamp(\"submitted_at\"),\n  createdAt: timestamp(\"created_at\").defaultNow().notNull(),\n  updatedAt: timestamp(\"updated_at\").defaultNow().notNull(),\n});\nexport const feedback = pgTable(\"feedback\", {\n  id: serial(\"id\").primaryKey(),\n  submissionId: integer(\"submission_id\").references(() => submissions.id).notNull(),\n  teacherId: integer(\"teacher_id\").references(() => users.id).notNull(),\n  bandScore: varchar(\"band_score\", { length: 10 }).notNull(),\n  comments: text(\"comments\").notNull(),\n  createdAt: timestamp(\"created_at\").defaultNow().notNull(),\n  updatedAt: timestamp(\"updated_at\").defaultNow().notNull(),\n});\n2. Glassmorphism Design System (src/app/globals.css)\ncss\n\n\n@import \"tailwindcss\";\n@layer base {\n  body {\n    @apply min-h-screen bg-slate-950 text-slate-100 font-sans antialiased selection:bg-indigo-500 selection:text-white;\n    background-image: \n      radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.15) 0px, transparent 50%),\n      radial-gradient(at 100% 0%, rgba(168, 85, 247, 0.15) 0px, transparent 50%),\n      radial-gradient(at 50% 100%, rgba(59, 130, 246, 0.12) 0px, transparent 50%);\n    background-attachment: fixed;\n  }\n}\n.glass-card {\n  background: rgba(15, 23, 42, 0.75);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n}\n.glass-card-hover {\n  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);\n}\n.glass-card-hover:hover {\n  border-color: rgba(99, 102, 241, 0.35);\n  transform: translateY(-2px);\n  box-shadow: 0 12px 30px -10px rgba(99, 102, 241, 0.2);\n}\n.glass-header {\n  background: rgba(15, 23, 42, 0.85);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n}\n.glass-input {\n  background: rgba(15, 23, 42, 0.6);\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  color: #f8fafc;\n}\n.glass-input:focus {\n  border-color: #6366f1;\n  box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);\n}\n.gradient-text {\n  background: linear-gradient(135deg, #818cf8 0%, #c084fc 50%, #60a5fa 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n.gradient-btn {\n  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);\n  transition: all 0.2s ease-in-out;\n}\n.gradient-btn:hover {\n  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);\n  box-shadow: 0 8px 20px -6px rgba(99, 102, 241, 0.4);\n  transform: translateY(-1px);\n}\n@keyframes fadeUp {\n  from { opacity: 0; transform: translateY(12px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n.animate-fade-up {\n  animation: fadeUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n3. Animated Root Layout (src/app/layout.tsx)\ntypescript\n\n\nimport type { Metadata } from \"next\";\nimport \"./globals.css\";\nexport const metadata: Metadata = {\n  title: \"IELTS Writing Platform | Standardized Exam & Practice Workspace\",\n  description: \"Exam-focused IELTS Writing practice platform with strict anti-cheat tracking and teacher evaluation.\",\n};\nexport default function RootLayout({\n  children,\n}: Readonly<{\n  children: React.ReactNode;\n}>) {\n  return (\n    <html lang=\"en\">\n      <body className=\"relative overflow-x-hidden\">\n        <div className=\"pointer-events-none fixed inset-0 z-0 overflow-hidden\">\n          <div className=\"animate-float-slow animate-pulse-glow absolute -top-40 -left-40 h-96 w-96 rounded-full bg-indigo-600/20 blur-[120px]\" />\n          <div className=\"animate-float-slow animate-pulse-glow absolute top-1/3 -right-40 h-96 w-96 rounded-full bg-purple-600/20 blur-[140px]\" style={{ animationDelay: \"-3s\" }} />\n          <div className=\"animate-float-slow animate-pulse-glow absolute -bottom-40 left-1/3 h-[30rem] w-[30rem] rounded-full bg-blue-600/15 blur-[160px]\" style={{ animationDelay: \"-5s\" }} />\n        </div>\n        <div className=\"relative z-10 min-h-screen\">\n          {children}\n        </div>\n      </body>\n    </html>\n  );\n}"
    items {
      text: "markdown\n\n\n# Application Name & Overview\n**IELTS Writing Homework Platform**\nAn exam-focused, real-time web application designed for IELTS preparation centers and tutors. It enables teachers to publish Task 1 & Task 2 writing assignments (both full essays and partial section practice), track student progress with strict anti-cheat monitoring (paste blocking and typing burst detection), and evaluate submitted essays with criteria-based band scores and detailed commentary.\n---\n# Key Functional Requirements\n### 1. Dual User Roles\n- **Teacher**: Publishes assignments (timers, due dates, Task 1 chart URLs, Task 2 essay prompts, section focus labels), creates student login IDs, resets credentials, tracks submission statuses, and evaluates essays.\n- **Student**: Logs in via a simple username ID, views assigned tasks, writes essays in an anti-cheat environment with live word counters and exam countdown timers, saves drafts, and reviews graded submission history.\n### 2. Anti-Cheat Writing Workspace (`/tasks/[id]`)\n- **Clipboard Protection**: Intercepts `onPaste` and `onDrop` events on the text editor, incrementing a `pasteAttemptCount` flag.\n- **Typing Burst Detection**: Monitors keystroke velocity (<15ms gap between keys) to flag automated macro injection.\n- **Live Exam Clock**: Countdown timer that automatically locks and submits the essay when time expires.\n- **Target Indicators**: Highlights progress against target word counts (150 words for Task 1; 250 words for Task 2).\n### 3. Evaluation Workspace (`/teacher/submissions/[id]`)\n- Side-by-side essay reader and instructor feedback card.\n- Quick band score selector pills (`5.0`, `5.5`, `6.0`, `6.5`, `7.0`, `7.5`, `8.0`, `8.5`, `9.0`).\n- Detailed commentary field for Task Response, Coherence & Cohesion, Lexical Resource, and Grammatical Range.\n---\n# Code Snippets & Architecture\n### 1. Database Schema (`src/db/schema.ts`)\n```typescript\nimport { boolean, integer, pgTable, serial, text, timestamp, varchar } from \"drizzle-orm/pg-core\";\nexport const users = pgTable(\"users\", {\n  id: serial(\"id\").primaryKey(),\n  name: text(\"name\").notNull(),\n  username: varchar(\"username\", { length: 100 }).unique(),\n  email: varchar(\"email\", { length: 255 }),\n  passwordHash: text(\"password_hash\").notNull(),\n  role: varchar(\"role\", { length: 20 }).notNull().default(\"student\"),\n  createdAt: timestamp(\"created_at\").defaultNow().notNull(),\n});\nexport const tasks = pgTable(\"tasks\", {\n  id: serial(\"id\").primaryKey(),\n  teacherId: integer(\"teacher_id\").references(() => users.id).notNull(),\n  title: text(\"title\").notNull(),\n  ieltsType: varchar(\"ielts_type\", { length: 20 }).notNull().default(\"task2\"),\n  assignmentMode: varchar(\"assignment_mode\", { length: 20 }).notNull().default(\"full\"),\n  focusLabel: text(\"focus_label\"),\n  promptText: text(\"prompt_text\").notNull(),\n  imageUrl: text(\"image_url\"),\n  timerMinutes: integer(\"timer_minutes\"),\n  dueDate: timestamp(\"due_date\").notNull(),\n  createdAt: timestamp(\"created_at\").defaultNow().notNull(),\n});\nexport const submissions = pgTable(\"submissions\", {\n  id: serial(\"id\").primaryKey(),\n  taskId: integer(\"task_id\").references(() => tasks.id).notNull(),\n  studentId: integer(\"student_id\").references(() => users.id).notNull(),\n  status: varchar(\"status\", { length: 20 }).notNull().default(\"draft\"),\n  content: text(\"content\").notNull().default(\"\"),\n  wordCount: integer(\"word_count\").notNull().default(0),\n  pasteAttemptCount: integer(\"paste_attempt_count\").notNull().default(0),\n  suspiciousBurstFlag: boolean(\"suspicious_burst_flag\").notNull().default(false),\n  submittedAt: timestamp(\"submitted_at\"),\n  createdAt: timestamp(\"created_at\").defaultNow().notNull(),\n  updatedAt: timestamp(\"updated_at\").defaultNow().notNull(),\n});\nexport const feedback = pgTable(\"feedback\", {\n  id: serial(\"id\").primaryKey(),\n  submissionId: integer(\"submission_id\").references(() => submissions.id).notNull(),\n  teacherId: integer(\"teacher_id\").references(() => users.id).notNull(),\n  bandScore: varchar(\"band_score\", { length: 10 }).notNull(),\n  comments: text(\"comments\").notNull(),\n  createdAt: timestamp(\"created_at\").defaultNow().notNull(),\n  updatedAt: timestamp(\"updated_at\").defaultNow().notNull(),\n});\n2. Glassmorphism Design System (src/app/globals.css)\ncss\n\n\n@import \"tailwindcss\";\n@layer base {\n  body {\n    @apply min-h-screen bg-slate-950 text-slate-100 font-sans antialiased selection:bg-indigo-500 selection:text-white;\n    background-image: \n      radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.15) 0px, transparent 50%),\n      radial-gradient(at 100% 0%, rgba(168, 85, 247, 0.15) 0px, transparent 50%),\n      radial-gradient(at 50% 100%, rgba(59, 130, 246, 0.12) 0px, transparent 50%);\n    background-attachment: fixed;\n  }\n}\n.glass-card {\n  background: rgba(15, 23, 42, 0.75);\n  backdrop-filter: blur(16px);\n  -webkit-backdrop-filter: blur(16px);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n}\n.glass-card-hover {\n  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);\n}\n.glass-card-hover:hover {\n  border-color: rgba(99, 102, 241, 0.35);\n  transform: translateY(-2px);\n  box-shadow: 0 12px 30px -10px rgba(99, 102, 241, 0.2);\n}\n.glass-header {\n  background: rgba(15, 23, 42, 0.85);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  border-bottom: 1px solid rgba(255, 255, 255, 0.1);\n}\n.glass-input {\n  background: rgba(15, 23, 42, 0.6);\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  color: #f8fafc;\n}\n.glass-input:focus {\n  border-color: #6366f1;\n  box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);\n}\n.gradient-text {\n  background: linear-gradient(135deg, #818cf8 0%, #c084fc 50%, #60a5fa 100%);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n}\n.gradient-btn {\n  background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);\n  transition: all 0.2s ease-in-out;\n}\n.gradient-btn:hover {\n  background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);\n  box-shadow: 0 8px 20px -6px rgba(99, 102, 241, 0.4);\n  transform: translateY(-1px);\n}\n@keyframes fadeUp {\n  from { opacity: 0; transform: translateY(12px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n.animate-fade-up {\n  animation: fadeUp 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;\n}\n3. Animated Root Layout (src/app/layout.tsx)\ntypescript\n\n\nimport type { Metadata } from \"next\";\nimport \"./globals.css\";\nexport const metadata: Metadata = {\n  title: \"IELTS Writing Platform | Standardized Exam & Practice Workspace\",\n  description: \"Exam-focused IELTS Writing practice platform with strict anti-cheat tracking and teacher evaluation.\",\n};\nexport default function RootLayout({\n  children,\n}: Readonly<{\n  children: React.ReactNode;\n}>) {\n  return (\n    <html lang=\"en\">\n      <body className=\"relative overflow-x-hidden\">\n        <div className=\"pointer-events-none fixed inset-0 z-0 overflow-hidden\">\n          <div className=\"animate-float-slow animate-pulse-glow absolute -top-40 -left-40 h-96 w-96 rounded-full bg-indigo-600/20 blur-[120px]\" />\n          <div className=\"animate-float-slow animate-pulse-glow absolute top-1/3 -right-40 h-96 w-96 rounded-full bg-purple-600/20 blur-[140px]\" style={{ animationDelay: \"-3s\" }} />\n          <div className=\"animate-float-slow animate-pulse-glow absolute -bottom-40 left-1/3 h-[30rem] w-[30rem] rounded-full bg-blue-600/15 blur-[160px]\" style={{ animationDelay: \"-5s\" }} />\n        </div>\n        <div className=\"relative z-10 min-h-screen\">\n          {children}\n        </div>\n      </body>\n    </html>\n  );\n}"
