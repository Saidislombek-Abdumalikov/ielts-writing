  file_change {
    absolute_path_uri: "file:///server.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import express from \'express\';\nimport path from \'path\';\nimport { createServer as createViteServer } from \'vite\';\nimport { requireAuth, AuthRequest } from \'./src/middleware/auth.ts\';\nimport { getOrCreateUser, getUser } from \'./src/db/users.ts\';\nimport { db } from \'./src/db/index.ts\';\nimport { tasks, submissions, feedback, users } from \'./src/db/schema.ts\';\nimport { eq, desc, and } from \'drizzle-orm\';\n\nasync function startServer() {\n  const app = express();\n  const PORT = 3000;\n\n  app.use(express.json());\n\n  // Check health\n  app.get(\'/api/health\', (req, res) => {\n    res.json({ status: \'ok\' });\n  });\n\n  // User auth registration\n  app.post(\'/api/auth/register\', requireAuth, async (req: AuthRequest, res) => {\n    try {\n      if (!req.user) {\n        res.status(401).json({ error: \'Unauthorized\' });\n        return;\n      }\n      const { uid, email, name } = req.user;\n      \n      const dbUser = await getOrCreateUser(uid, email || \'\', name || email || \'User\');\n      res.json(dbUser);\n    } catch (error: any) {\n      console.error(\'Failed to register user:\', error);\n      res.status(500).json({ error: \'Failed to register user\' });\n    }\n  });\n\n  // Get current user profile\n  app.get(\'/api/users/me\', requireAuth, async (req: AuthRequest, res) => {\n    try {\n      if (!req.user) {\n        res.status(401).json({ error: \'Unauthorized\' });\n        return;\n      }\n      const dbUser = await getUser(req.user.uid);\n      if (!dbUser) {\n        res.status(404).json({ error: \'User not found\' });\n        return;\n      }\n      res.json(dbUser);\n    } catch (error: any) {\n      console.error(\'Failed to get user:\', error);\n      res.status(500).json({ error: \'Failed to get user profile\' });\n    }\n  });\n\n  // List tasks\n  app.get(\'/api/tasks\', requireAuth, async (req: AuthRequest, res) => {\n    try {\n      const allTasks = await db.select().from(tasks).orderBy(desc(tasks.createdAt));\n      res.json(allTasks);\n    } catch (error: any) {\n      console.error(\'Failed to fetch tasks:\', error);\n      res.status(500).json({ error: \'Failed to fetch tasks\' });\n    }\n  });\n\n  // Get specific task\n  app.get(\'/api/tasks/:id\', requireAuth, async (req: AuthRequest, res) => {\n    try {\n      const taskId = parseInt(req.params.id);\n      const task = await db.select().from(tasks).where(eq(tasks.id, taskId));\n      if (task.length === 0) {\n        res.status(404).json({ error: \'Task not found\' });\n        return;\n      }\n      res.json(task[0]);\n    } catch (error: any) {\n      console.error(\'Failed to fetch task:\', error);\n      res.status(500).json({ error: \'Failed to fetch task\' });\n    }\n  });\n\n  // Create task (Teacher only)\n  app.post(\'/api/tasks\', requireAuth, async (req: AuthRequest, res) => {\n    try {\n      if (!req.user) return;\n      const user = await getUser(req.user.uid);\n      if (!user || user.role !== \'teacher\') {\n        res.status(403).json({ error: \'Forbidden: Teachers only\' });\n        return;\n      }\n      \n      const newTask = await db.insert(tasks).values({\n        ...req.body,\n        teacherId: user.id,\n        dueDate: new Date(req.body.dueDate)\n      }).returning();\n      \n      res.json(newTask[0]);\n    } catch (error: any) {\n      console.error(\'Failed to create task:\', error);\n      res.status(500).json({ error: \'Failed to create task\' });\n    }\n  });\n\n  // Student submission sync (Draft or final)\n  app.post(\'/api/submissions/:taskId\', requireAuth, async (req: AuthRequest, res) => {\n    try {\n      if (!req.user) return;\n      const user = await getUser(req.user.uid);\n      if (!user) {\n        res.status(404).json({ error: \'User not found\' });\n        return;\n      }\n      \n      const taskId = parseInt(req.params.taskId);\n      const { content, wordCount, pasteAttemptCount, suspiciousBurstFlag, status } = req.body;\n      \n      // Check if submission already exists\n      const existing = await db.select().from(submissions).where(\n        and(eq(submissions.taskId, taskId), eq(submissions.studentId, user.id))\n      );\n      \n      if (existing.length > 0) {\n        const updated = await db.update(submissions).set({\n          content,\n          wordCount,\n          pasteAttemptCount: existing[0].pasteAttemptCount + (pasteAttemptCount || 0),\n          suspiciousBurstFlag: existing[0].suspiciousBurstFlag || suspiciousBurstFlag,\n          status,\n          updatedAt: new Date(),\n          submittedAt: status === \'submitted\' ? new Date() : existing[0].submittedAt,\n        }).where(eq(submissions.id, existing[0].id)).returning();\n        res.json(updated[0]);\n      } else {\n        const newSub = await db.insert(submissions).values({\n          taskId,\n          studentId: user.id,\n          content,\n          wordCount,\n          pasteAttemptCount: pasteAttemptCount || 0,\n          suspiciousBurstFlag: suspiciousBurstFlag || false,\n          status,\n          submittedAt: status === \'submitted\' ? new Date() : null,\n        }).returning();\n        res.json(newSub[0]);\n      }\n    } catch (error: any) {\n      console.error(\'Failed to save submission:\', error);\n      res.status(500).json({ error: \'Failed to save submission\' });\n    }\n  });\n\n  // Get student\'s submission for a task\n  app.get(\'/api/submissions/:taskId/me\', requireAuth, async (req: AuthRequest, res) => {\n    try {\n      if (!req.user) return;\n      const user = await getUser(req.user.uid);\n      if (!user) {\n        res.status(404).json({ error: \'User not found\' });\n        return;\n      }\n      \n      const taskId = parseInt(req.params.taskId);\n      const sub = await db.select().from(submissions).where(\n        and(eq(submissions.taskId, taskId), eq(submissions.studentId, user.id))\n      );\n      \n      if (sub.length === 0) {\n        res.status(404).json({ error: \'No submission found\' });\n        return;\n      }\n      res.json(sub[0]);\n    } catch (error: any) {\n      console.error(\'Failed to get submission:\', error);\n      res.status(500).json({ error: \'Failed to fetch submission\' });\n    }\n  });\n\n  // Get all submissions for a task (Teacher only)\n  app.get(\'/api/tasks/:taskId/submissions\', requireAuth, async (req: AuthRequest, res) => {\n    try {\n      if (!req.user) return;\n      const user = await getUser(req.user.uid);\n      if (!user || user.role !== \'teacher\') {\n        res.status(403).json({ error: \'Forbidden: Teachers only\' });\n        return;\n      }\n      \n      const taskId = parseInt(req.params.taskId);\n      // Join with users to get student name\n      const allSubs = await db.select({\n        submission: submissions,\n        student: { id: users.id, name: users.name, email: users.email }\n      })\n      .from(submissions)\n      .innerJoin(users, eq(submissions.studentId, users.id))\n      .where(eq(submissions.taskId, taskId))\n      .orderBy(desc(submissions.updatedAt));\n      \n      res.json(allSubs);\n    } catch (error: any) {\n      console.error(\'Failed to get submissions:\', error);\n      res.status(500).json({ error: \'Failed to fetch submissions\' });\n    }\n  });\n  \n  // Submit feedback (Teacher only)\n  app.post(\'/api/submissions/:subId/feedback\', requireAuth, async (req: AuthRequest, res) => {\n    try {\n      if (!req.user) return;\n      const user = await getUser(req.user.uid);\n      if (!user || user.role !== \'teacher\') {\n        res.status(403).json({ error: \'Forbidden: Teachers only\' });\n        return;\n      }\n      \n      const subId = parseInt(req.params.subId);\n      const { bandScore, comments } = req.body;\n      \n      // Update submission status to graded\n      await db.update(submissions).set({ status: \'graded\', updatedAt: new Date() }).where(eq(submissions.id, subId));\n      \n      const newFeedback = await db.insert(feedback).values({\n        submissionId: subId,\n        teacherId: user.id,\n        bandScore,\n        comments,\n      }).returning();\n      \n      res.json(newFeedback[0]);\n    } catch (error: any) {\n      console.error(\'Failed to submit feedback:\', error);\n      res.status(500).json({ error: \'Failed to submit feedback\' });\n    }\n  });\n  \n  // Get feedback for a submission\n  app.get(\'/api/submissions/:subId/feedback\', requireAuth, async (req: AuthRequest, res) => {\n    try {\n      const subId = parseInt(req.params.subId);\n      const fb = await db.select().from(feedback).where(eq(feedback.submissionId, subId));\n      \n      if (fb.length === 0) {\n        res.status(404).json({ error: \'No feedback found\' });\n        return;\n      }\n      res.json(fb[0]);\n    } catch (error: any) {\n      console.error(\'Failed to get feedback:\', error);\n      res.status(500).json({ error: \'Failed to fetch feedback\' });\n    }\n  });\n\n\n  // Vite middleware for development\n  if (process.env.NODE_ENV !== \'production\') {\n    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    const distPath = path.join(process.cwd(), \'dist\');\n    app.use(express.static(distPath));\n    app.get(\'*\', (req, res) => {\n      res.sendFile(path.join(distPath, \'index.html\'));\n    });\n  }\n\n  app.listen(PORT, \'0.0.0.0\', () => {\n    console.log(`Server running on http://0.0.0.0:${PORT}`);\n  });\n}\n\nstartServer();\n"
    }
