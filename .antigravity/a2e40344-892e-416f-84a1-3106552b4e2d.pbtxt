    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { api } from \'../lib/api.ts\';\nimport { useAuth } from \'../components/AuthContext.tsx\';\nimport { UserPlus, Shield } from \'lucide-react\';\nimport { motion } from \'motion/react\';\n\nexport default function AdminDashboard() {\n  const { dbUser } = useAuth();\n  const [formData, setFormData] = useState({\n    name: \'\',\n    username: \'\',\n    password: \'\',\n    role: \'student\'\n  });\n  const [error, setError] = useState(\'\');\n  const [success, setSuccess] = useState(\'\');\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setError(\'\');\n    setSuccess(\'\');\n    try {\n      await api.post(\'/api/auth/register\', formData);\n      setSuccess(`User ${formData.username} created successfully!`);\n      setFormData({ name: \'\', username: \'\', password: \'\', role: \'student\' });\n    } catch (err: any) {\n      setError(err.message || \'Failed to create user\');\n    }\n  };\n\n  return (\n    <div className=\"space-y-8 animate-fade-up max-w-2xl mx-auto\">\n      <div className=\"flex justify-between items-end mb-8\">\n        <div>\n          <h2 className=\"text-3xl font-bold tracking-tight mb-2 flex items-center\">\n            <Shield className=\"w-8 h-8 mr-3 text-indigo-400\" />\n            Admin / User Management\n          </h2>\n          <p className=\"text-slate-400\">Create accounts for {dbUser?.role === \'admin\' ? \'teachers and students\' : \'students\'}.</p>\n        </div>\n      </div>\n\n      <motion.div \n        className=\"glass-card p-8 rounded-2xl\"\n      >\n        <h3 className=\"text-xl font-semibold mb-6 flex items-center\">\n          <UserPlus className=\"w-5 h-5 mr-2 text-indigo-400\" />\n          Create New User\n        </h3>\n\n        {error && (\n          <div className=\"mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-xl text-red-400 text-sm\">\n            {error}\n          </div>\n        )}\n\n        {success && (\n          <div className=\"mb-6 p-4 bg-emerald-500/10 border border-emerald-500/30 rounded-xl text-emerald-400 text-sm\">\n            {success}\n          </div>\n        )}\n\n        <form onSubmit={handleSubmit} className=\"space-y-5\">\n          <div>\n            <label className=\"block text-sm font-medium text-slate-300 mb-2\">Full Name</label>\n            <input \n              type=\"text\" \n              required \n              className=\"w-full glass-input px-4 py-3 rounded-xl text-sm\" \n              placeholder=\"e.g. John Doe\"\n              value={formData.name}\n              onChange={e => setFormData({ ...formData, name: e.target.value })}\n            />\n          </div>\n          \n          <div>\n            <label className=\"block text-sm font-medium text-slate-300 mb-2\">Username</label>\n            <input \n              type=\"text\" \n              required \n              className=\"w-full glass-input px-4 py-3 rounded-xl text-sm\" \n              placeholder=\"e.g. student123\"\n              value={formData.username}\n              onChange={e => setFormData({ ...formData, username: e.target.value })}\n            />\n          </div>\n          \n          <div>\n            <label className=\"block text-sm font-medium text-slate-300 mb-2\">Password</label>\n            <input \n              type=\"password\" \n              required \n              className=\"w-full glass-input px-4 py-3 rounded-xl text-sm\" \n              placeholder=\"Minimum 6 characters\"\n              value={formData.password}\n              onChange={e => setFormData({ ...formData, password: e.target.value })}\n            />\n          </div>\n\n          <div>\n            <label className=\"block text-sm font-medium text-slate-300 mb-2\">Role</label>\n            <select \n              className=\"w-full glass-input px-4 py-3 rounded-xl text-sm appearance-none\"\n              value={formData.role}\n              onChange={e => setFormData({ ...formData, role: e.target.value })}\n            >\n              <option value=\"student\">Student</option>\n              {dbUser?.role === \'admin\' && (\n                <option value=\"teacher\">Teacher</option>\n              )}\n            </select>\n          </div>\n          \n          <button\n            type=\"submit\"\n            className=\"w-full gradient-btn py-3 px-4 rounded-xl font-medium mt-6\"\n          >\n            Create Account\n          </button>\n        </form>\n      </motion.div>\n    </div>\n  );\n}"
    }
