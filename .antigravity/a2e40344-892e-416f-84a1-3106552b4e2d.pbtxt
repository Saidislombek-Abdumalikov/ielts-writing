  file_change {
    absolute_path_uri: "file:///src/pages/EvaluationWorkspace.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useEffect, useState } from \'react\';\nimport { api } from \'../lib/api.ts\';\nimport { useParams, useNavigate } from \'react-router\';\nimport { motion } from \'motion/react\';\nimport { ArrowLeft, CheckCircle, AlertTriangle, MessageSquare } from \'lucide-react\';\n\nexport default function EvaluationWorkspace() {\n  const { id } = useParams();\n  const navigate = useNavigate();\n  const [task, setTask] = useState<any>(null);\n  const [submissions, setSubmissions] = useState<any[]>([]);\n  const [selectedSub, setSelectedSub] = useState<any>(null);\n  const [feedback, setFeedback] = useState({ bandScore: \'6.5\', comments: \'\' });\n  const [existingFeedback, setExistingFeedback] = useState<any>(null);\n\n  useEffect(() => {\n    api.get(`/api/tasks/${id}`).then(setTask);\n    loadSubmissions();\n  }, [id]);\n\n  const loadSubmissions = () => {\n    api.get(`/api/tasks/${id}/submissions`).then(setSubmissions);\n  };\n\n  const handleSelectSub = (sub: any) => {\n    setSelectedSub(sub);\n    api.get(`/api/submissions/${sub.submission.id}/feedback`)\n      .then(data => {\n        setExistingFeedback(data);\n        setFeedback({ bandScore: data.bandScore, comments: data.comments });\n      })\n      .catch(() => {\n        setExistingFeedback(null);\n        setFeedback({ bandScore: \'6.5\', comments: \'\' });\n      });\n  };\n\n  const submitFeedback = async () => {\n    if (!selectedSub) return;\n    await api.post(`/api/submissions/${selectedSub.submission.id}/feedback`, feedback);\n    loadSubmissions();\n    handleSelectSub(selectedSub);\n  };\n\n  if (!task) return <div className=\"p-10 text-center animate-pulse\">Loading workspace...</div>;\n\n  const bandScores = [\'5.0\', \'5.5\', \'6.0\', \'6.5\', \'7.0\', \'7.5\', \'8.0\', \'8.5\', \'9.0\'];\n\n  return (\n    <div className=\"flex flex-col h-screen overflow-hidden\">\n      <header className=\"glass-header px-6 py-4 flex items-center border-b border-slate-800 shrink-0\">\n        <button onClick={() => navigate(\'/\')} className=\"mr-4 p-2 rounded-full hover:bg-slate-800 transition-colors\">\n          <ArrowLeft className=\"w-5 h-5 text-slate-400\" />\n        </button>\n        <div>\n          <h1 className=\"text-xl font-bold\">{task.title}</h1>\n          <p className=\"text-sm text-slate-400\">Evaluation Workspace</p>\n        </div>\n      </header>\n\n      <div className=\"flex flex-1 overflow-hidden\">\n        {/* Left sidebar: Submissions List */}\n        <div className=\"w-1/4 border-r border-slate-800 flex flex-col bg-slate-900/30 overflow-y-auto\">\n          <div className=\"p-4 border-b border-slate-800 font-medium text-slate-300\">\n            Student Submissions ({submissions.length})\n          </div>\n          <div className=\"flex-1 overflow-y-auto p-2 space-y-2\">\n            {submissions.map((sub, idx) => (\n              <button\n                key={sub.submission.id}\n                onClick={() => handleSelectSub(sub)}\n                className={`w-full text-left p-4 rounded-xl transition-all ${\n                  selectedSub?.submission.id === sub.submission.id \n                    ? \'bg-indigo-500/20 border border-indigo-500/30\' \n                    : \'hover:bg-slate-800/50 border border-transparent\'\n                }`}\n              >\n                <div className=\"flex justify-between items-center mb-1\">\n                  <span className=\"font-medium text-slate-200\">{sub.student.name}</span>\n                  {sub.submission.status === \'graded\' ? (\n                    <CheckCircle className=\"w-4 h-4 text-emerald-500\" />\n                  ) : sub.submission.status === \'submitted\' ? (\n                    <div className=\"w-2 h-2 rounded-full bg-amber-500\" />\n                  ) : (\n                    <span className=\"text-xs text-slate-500\">Draft</span>\n                  )}\n                </div>\n                <div className=\"flex items-center text-xs text-slate-400 space-x-3\">\n                  <span>{sub.submission.wordCount} words</span>\n                  {sub.submission.suspiciousBurstFlag && (\n                    <span className=\"text-red-400 flex items-center\" title=\"Suspicious typing burst detected\"><AlertTriangle className=\"w-3 h-3 mr-1\" /> Burst</span>\n                  )}\n                  {sub.submission.pasteAttemptCount > 0 && (\n                    <span className=\"text-amber-400 flex items-center\"><AlertTriangle className=\"w-3 h-3 mr-1\" /> {sub.submission.pasteAttemptCount} pastes</span>\n                  )}\n                </div>\n              </button>\n            ))}\n            {submissions.length === 0 && (\n              <div className=\"text-center p-6 text-slate-500 text-sm\">No submissions yet.</div>\n            )}\n          </div>\n        </div>\n\n        {/* Middle: Essay Reader */}\n        <div className=\"flex-1 flex flex-col bg-slate-950 overflow-hidden\">\n          {selectedSub ? (\n            <>\n              <div className=\"p-6 border-b border-slate-800 bg-slate-900/50 shrink-0\">\n                <h2 className=\"text-lg font-semibold mb-2\">{selectedSub.student.name}\'s Essay</h2>\n                <div className=\"flex space-x-4 text-sm\">\n                  <span className=\"text-slate-400\">Words: <strong className=\"text-slate-200\">{selectedSub.submission.wordCount}</strong></span>\n                  <span className=\"text-slate-400\">Status: <strong className=\"text-slate-200 capitalize\">{selectedSub.submission.status}</strong></span>\n                  <span className=\"text-slate-400\">Submitted: <strong className=\"text-slate-200\">{selectedSub.submission.submittedAt ? new Date(selectedSub.submission.submittedAt).toLocaleString() : \'N/A\'}</strong></span>\n                </div>\n                \n                {/* Prompt Accordion */}\n                <details className=\"mt-4 text-sm bg-slate-800/40 rounded-lg group\">\n                  <summary className=\"p-3 cursor-pointer text-slate-300 font-medium select-none flex items-center justify-between\">\n                    View Prompt\n                    <span className=\"text-slate-500 text-xs group-open:hidden\">Click to expand</span>\n                  </summary>\n                  <div className=\"p-4 border-t border-slate-700/50 text-slate-400 whitespace-pre-wrap\">\n                    {task.promptText}\n                  </div>\n                </details>\n              </div>\n              <div className=\"flex-1 p-8 overflow-y-auto\">\n                <div className=\"max-w-3xl mx-auto\">\n                  <p className=\"whitespace-pre-wrap leading-relaxed text-slate-300 text-lg font-serif\">\n                    {selectedSub.submission.content || <span className=\"italic text-slate-600\">No content written yet.</span>}\n                  </p>\n                </div>\n              </div>\n            </>\n          ) : (\n            <div className=\"flex-1 flex items-center justify-center text-slate-500 flex-col\">\n              <MessageSquare className=\"w-12 h-12 mb-4 opacity-20\" />\n              <p>Select a student submission to evaluate</p>\n            </div>\n          )}\n        </div>\n\n        {/* Right sidebar: Evaluation Card */}\n        {selectedSub && (\n          <div className=\"w-1/3 border-l border-slate-800 bg-slate-900/40 flex flex-col overflow-hidden shadow-2xl\">\n            <div className=\"p-6 border-b border-slate-800 shrink-0\">\n              <h3 className=\"font-semibold text-lg flex items-center\">\n                <CheckCircle className=\"w-5 h-5 mr-2 text-indigo-400\" /> \n                Evaluation Panel\n              </h3>\n            </div>\n            \n            <div className=\"p-6 flex-1 overflow-y-auto\">\n              <div className=\"mb-8\">\n                <label className=\"block text-sm font-medium text-slate-300 mb-3\">Overall Band Score</label>\n                <div className=\"flex flex-wrap gap-2\">\n                  {bandScores.map(score => (\n                    <button\n                      key={score}\n                      onClick={() => setFeedback({ ...feedback, bandScore: score })}\n                      disabled={!!existingFeedback}\n                      className={`px-3 py-2 rounded-lg text-sm font-bold transition-all ${\n                        feedback.bandScore === score \n                          ? \'bg-indigo-500 text-white shadow-[0_0_15px_rgba(99,102,241,0.5)] scale-110 border-indigo-400\' \n                          : \'bg-slate-800 text-slate-400 hover:bg-slate-700 border border-transparent\'\n                      }`}\n                    >\n                      {score}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              <div className=\"flex-1 flex flex-col h-full min-h-[300px]\">\n                <label className=\"block text-sm font-medium text-slate-300 mb-3\">Detailed Commentary</label>\n                <textarea \n                  className=\"w-full flex-1 glass-input p-4 rounded-xl resize-none text-sm leading-relaxed min-h-[300px]\"\n                  placeholder=\"Task Response: ...&#10;Coherence & Cohesion: ...&#10;Lexical Resource: ...&#10;Grammatical Range: ...\"\n                  value={feedback.comments}\n                  onChange={e => setFeedback({ ...feedback, comments: e.target.value })}\n                  readOnly={!!existingFeedback}\n                />\n              </div>\n            </div>\n            \n            {!existingFeedback && (\n              <div className=\"p-6 border-t border-slate-800 shrink-0 bg-slate-900\">\n                <button \n                  onClick={submitFeedback}\n                  className=\"w-full gradient-btn py-3 rounded-xl font-medium shadow-lg hover:shadow-indigo-500/25 transition-all\"\n                >\n                  Submit Official Evaluation\n                </button>\n              </div>\n            )}\n            \n            {existingFeedback && (\n              <div className=\"p-6 border-t border-slate-800 shrink-0 bg-emerald-900/20 text-emerald-400 text-center font-medium rounded-t-2xl\">\n                Evaluation submitted on {new Date(existingFeedback.createdAt).toLocaleDateString()}\n              </div>\n            )}\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n"
    }
